  clientNotificationRequired Boolean   @default(false)
  clientNotified             Boolean   @default(false)
  clientNotifiedAt           DateTime? @db.Timestamptz(6)
  clientAcknowledged         Boolean   @default(false)
  clientAcknowledgedAt       DateTime? @db.Timestamptz(6)
