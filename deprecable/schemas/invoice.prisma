  @@index([tenantId, isAutomaticRevision]) // Automation tracking
  @@index([tenantId, triggerSource]) // Source tracking
  @@index([tenantId, complexityScore]) // Complexity analysis
  @@index([tenantId, impactScore]) // Impact analysis
  @@index([tenantId, requestedByMemberId]) // Requester tracking
  @@index([tenantId, reviewedByMemberId]) // Reviewer tracking
