  // Hierarchy relationships
  parentItem ProjectScheduleItem?  @relation("ScheduleItemHierarchy", fields: [tenantId, parentItemId], references: [tenantId, id], onDelete: Restrict)
  childItems ProjectScheduleItem[] @relation("ScheduleItemHierarchy")

  // ─────────────────────────────────────────────────────────────
