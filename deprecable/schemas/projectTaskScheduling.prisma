  // 🧠 Governance
  auditCorrelationId String? @db.Uuid
  dataClassification String  @default("INTERNAL") @db.VarChar(50)
  retentionPolicy    String? @db.VarChar(50)
  metadata           Json?   @db.JsonB
  recordSource       String? @db.VarChar(50)
  timezone           String? @db.VarChar(50)

  // 🗂️ Indexes & Constraints
  @@unique([tenantId, id])
  @@index([tenantId, taskId])
  @@index([tenantId, parentCommentId])
  @@index([tenantId, commentType])
  @@index([tenantId, isResolved])
  @@index([tenantId, isUrgent])
  @@index([tenantId, requiresResponse])
  @@index([tenantId, visibility])
  @@index([tenantId, isClientVisible])
  @@index([tenantId, priority])
  @@index([tenantId, status])
  @@index([tenantId, createdByActorId])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([metadata], type: Gin)
  @@map("project_task_comment")
}

model ProjectTaskAttachment {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 🔗 Parent Relations (REQUIRED)
  taskId      String @db.Uuid
  projectTask ProjectTask @relation("ProjectTaskToAttachments", fields: [tenantId, taskId], references: [tenantId, id], onDelete: Cascade)

  // 📎 File Information
  fileName        String  @db.VarChar(255)
  originalName    String  @db.VarChar(255) // Original uploaded filename
  fileType        String  @db.VarChar(100) // MIME type
  fileExtension   String  @db.VarChar(20)  // .jpg, .pdf, etc.
  fileSize        BigInt  @default(0)      // Size in bytes
  filePath        String  @db.VarChar(500) // Storage path/URL

  // 📊 File Classification
  attachmentType  String  @default("DOCUMENT") @db.VarChar(50) // PHOTO, DOCUMENT, DRAWING, SPECIFICATION, VIDEO, AUDIO
  category        String? @db.VarChar(100) // Progress, Quality, Safety, etc.
  subcategory     String? @db.VarChar(100) // More specific classification

  // 📝 Content Description
  title           String? @db.VarChar(255)
  description     String? @db.Text
  tags            Json?   @db.JsonB // Array of tag strings
  keywords        Json?   @db.JsonB // Search keywords

  // 📅 Version Control
  versionNumber   Int     @default(1)
  isLatestVersion Boolean @default(true)
  supersededBy    String? @db.Uuid // ID of newer version
  supersedes      String? @db.Uuid // ID of older version
  versionNotes    String? @db.Text

  // 🔍 Content Analysis
  hasOCRData      Boolean @default(false)
  ocrText         String? @db.Text // Extracted text content
  contentHash     String? @db.VarChar(64) // File content hash
  thumbnailPath   String? @db.VarChar(500) // Thumbnail/preview path

  // 📐 Image/Media Properties
  imageWidth      Int?    // For images
  imageHeight     Int?    // For images
  duration        Int?    // For video/audio (seconds)
  resolution      String? @db.VarChar(50) // Image resolution
  colorDepth      Int?    // Color depth for images

  // 📍 Location & Context
  gpsLatitude     Decimal? @db.Decimal(10, 8) // GPS coordinates
  gpsLongitude    Decimal? @db.Decimal(11, 8)
  locationName    String?  @db.VarChar(255)
  capturedAt      DateTime? @db.Timestamptz(6) // When photo/file was captured
  deviceInfo      String?  @db.VarChar(255) // Camera/device information

  // 🔐 Access Control
  visibility      String  @default("TEAM") @db.VarChar(50) // TEAM, PROJECT, PRIVATE, CLIENT, PUBLIC
  isPublic        Boolean @default(false)
  isClientVisible Boolean @default(false)
  requiresLogin   Boolean @default(true)
  downloadAllowed Boolean @default(true)

  // 📋 Approval & Review
  requiresApproval Boolean @default(false)
  approvedBy      String? @db.Uuid
  approvedAt      DateTime? @db.Timestamptz(6)
  approvalNotes   String? @db.Text
  rejectionReason String? @db.Text

  // 🎯 Quality & Compliance
  isQualityRecord Boolean @default(false) // Quality documentation
  isSafetyRecord  Boolean @default(false) // Safety documentation
  isComplianceDoc Boolean @default(false) // Compliance document
  expiryDate      DateTime? @db.Timestamptz(6) // For certificates, permits

  // 🔗 Cross-References
  linkedCommentId String? @db.Uuid // Associated comment
  linkedTaskIds   Json?   @db.JsonB // Array of related task IDs
  linkedDocumentIds Json? @db.JsonB // Array of related document IDs
  externalId      String? @db.VarChar(255) // External system reference

  // 📊 Usage Tracking
  downloadCount   Int     @default(0)
  viewCount       Int     @default(0)
  lastAccessedAt  DateTime? @db.Timestamptz(6)
  lastAccessedBy  String?   @db.Uuid

  // 🔧 Processing Status
  processingStatus String @default("READY") @db.VarChar(50) // UPLOADING, PROCESSING, READY, ERROR
  processingError  String? @db.Text
  virusScanStatus  String? @db.VarChar(50) // PENDING, CLEAN, INFECTED, ERROR
  virusScanDate    DateTime? @db.Timestamptz(6)

  // 📱 Source Information
  uploadSource    String? @db.VarChar(50) // WEB, MOBILE, EMAIL, API
  uploadDevice    String? @db.VarChar(255) // Device information
  uploadMethod    String? @db.VarChar(50) // FORM, DRAG_DROP, API, EMAIL

  // 🗄️ Storage & Backup
  storageProvider String? @db.VarChar(100) // S3, Azure, Local, etc.
  storageRegion   String? @db.VarChar(100) // Storage region/location
  isBackedUp      Boolean @default(false)
  backupDate      DateTime? @db.Timestamptz(6)

  // 📊 Lifecycle
  status    String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, ARCHIVED, DELETED, SUPERSEDED
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs Only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String? @db.Uuid
  dataClassification String  @default("INTERNAL") @db.VarChar(50)
  retentionPolicy    String? @db.VarChar(50)
  metadata           Json?   @db.JsonB
  recordSource       String? @db.VarChar(50)
  timezone           String? @db.VarChar(50)

  // 🗂️ Indexes & Constraints
  @@unique([tenantId, id])
  @@unique([tenantId, taskId, fileName, versionNumber])
  @@index([tenantId, taskId])
  @@index([tenantId, attachmentType])
  @@index([tenantId, fileType])
  @@index([tenantId, category])
  @@index([tenantId, isLatestVersion])
  @@index([tenantId, requiresApproval])
  @@index([tenantId, isQualityRecord])
  @@index([tenantId, isSafetyRecord])
  @@index([tenantId, isComplianceDoc])
  @@index([tenantId, visibility])
  @@index([tenantId, isClientVisible])
  @@index([tenantId, status])
  @@index([tenantId, processingStatus])
  @@index([tenantId, capturedAt])
  @@index([tenantId, expiryDate])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([metadata], type: Gin)
  @@map("project_task_attachment")
}

// ============================================================================
// PROJECT TASK SCHEDULING ENUMS
// ============================================================================

/// Task status lifecycle for work execution
enum ProjectTaskStatus {
  NOT_STARTED       // Task not yet begun
  IN_PROGRESS       // Work in progress
  BLOCKED           // Blocked by dependencies or issues
  ON_HOLD           // Temporarily paused
  UNDER_REVIEW      // Work completed, under review
  COMPLETED         // Task completed successfully
  CANCELLED         // Task cancelled
  REWORK_REQUIRED   // Rework needed
}

/// Task type classification for WBS organization
enum ProjectTaskType {
  WORK_PACKAGE      // Standard work package
  MILESTONE         // Project milestone
  SUMMARY_TASK      // Parent/summary task
  DELIVERABLE       // Specific deliverable
  INSPECTION        // Quality inspection task
  APPROVAL          // Approval gate
  PROCUREMENT       // Procurement activity
  SETUP             // Setup/preparation work
  CLEANUP           // Cleanup/finishing work
}

/// Task priority levels for resource allocation
enum ProjectTaskPriority {
  LOW               // Low priority
  NORMAL            // Normal priority
  HIGH              // High priority
  URGENT            // Urgent - expedite
  CRITICAL          // Critical path item
}

/// Task complexity levels for resource planning
enum ProjectTaskComplexity {
  SIMPLE            // Simple task - entry level
  STANDARD          // Standard complexity
  COMPLEX           // Complex - requires experience
  EXPERT            // Expert level required
  SPECIALIZED       // Specialized skills required
}

/// Task assignment status lifecycle
enum ProjectTaskAssignmentStatus {
  ASSIGNED          // Resource assigned
  ACCEPTED          // Assignment accepted
  IN_PROGRESS       // Work in progress
  COMPLETED         // Assignment completed
  DECLINED          // Assignment declined
  REASSIGNED        // Reassigned to different resource
  CANCELLED         // Assignment cancelled
}

/// Task assignment role types
enum ProjectTaskAssignmentRole {
  PRIMARY           // Primary responsible party
  SECONDARY         // Secondary support
  SUPERVISOR        // Supervising the work
  SPECIALIST        // Technical specialist
  HELPER            // Assistant/helper
  INSPECTOR         // Quality inspector
  CLIENT_REP        // Client representative
}

/// Task dependency types for scheduling
enum ProjectTaskDependencyType {
  FINISH_TO_START   // Predecessor must finish before successor starts (FS)
  START_TO_START    // Both tasks start at same time (SS)
  FINISH_TO_FINISH  // Both tasks finish at same time (FF)
  START_TO_FINISH   // Successor can't finish until predecessor starts (SF)
}

/// Schedule management status for tracking
enum ProjectScheduleManagementStatus {
  DRAFT             // Schedule in draft
  BASELINE          // Baseline schedule
  CURRENT           // Current working schedule
  UPDATED           // Updated schedule
  APPROVED          // Approved schedule
  ARCHIVED          // Archived schedule
}

/// Schedule item status
enum ProjectScheduleItemStatus {
  SCHEDULED         // Item scheduled
  IN_PROGRESS       // Work in progress
  COMPLETED         // Item completed
  DELAYED           // Behind schedule
  RESCHEDULED       // Rescheduled
  CANCELLED         // Cancelled
}

/// Critical path status
enum ProjectCriticalPathStatus {
  ACTIVE            // Active critical path
  INACTIVE          // Not on critical path
  UPDATED           // Path updated
  ARCHIVED          // Archived path
}

/// Baseline status for variance tracking
enum ProjectBaselineStatus {
  DRAFT             // Baseline in draft
  APPROVED          // Approved baseline
  CURRENT           // Current baseline
  SUPERSEDED        // Superseded by new baseline
  ARCHIVED          // Archived baseline
}

/// Checklist item status
enum ProjectChecklistItemStatus {
  PENDING           // Not yet started
  IN_PROGRESS       // In progress
  COMPLETED         // Completed successfully
  FAILED            // Failed requirements
  WAIVED            // Requirements waived
  NOT_APPLICABLE    // Not applicable
}

/// Checklist item priority
enum ProjectChecklistItemPriority {
  LOW               // Low priority
  NORMAL            // Normal priority
  HIGH              // High priority
  CRITICAL          // Critical - must complete
  MANDATORY         // Mandatory compliance item
}

/// Task comment status
enum ProjectTaskCommentStatus {
  ACTIVE            // Active comment
  RESOLVED          // Issue resolved
  ARCHIVED          // Archived comment
  DELETED           // Soft deleted
}

/// Task comment type
enum ProjectTaskCommentType {
  GENERAL           // General comment
  ISSUE             // Issue reported
  QUESTION          // Question asked
  UPDATE            // Status update
  APPROVAL          // Approval note
  INSTRUCTION       // Work instruction
  WARNING           // Warning/caution
}

/// Task attachment status
enum ProjectTaskAttachmentStatus {
  ACTIVE            // Active attachment
  ARCHIVED          // Archived attachment
  DELETED           // Soft deleted
  SUPERSEDED        // Replaced by newer version
}

/// Task attachment type
enum ProjectTaskAttachmentType {
  PHOTO             // Progress photo
  DOCUMENT          // Document attachment
  DRAWING           // Technical drawing
  SPECIFICATION     // Specifications
  INSPECTION        // Inspection report
  CERTIFICATE       // Certificate/compliance
  VIDEO             // Video documentation
  AUDIO             // Audio recording
  PLAN              // Work plan
  REPORT            // Progress report
}
