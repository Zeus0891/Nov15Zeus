  @@index([tenantId, itemType])
  @@index([tenantId, priority])
  @@index([tenantId, workflowStatus])

  // Critical flags (performance queries)
  @@index([tenantId, isCritical])
  @@index([tenantId, isMilestone])
  @@index([tenantId, isDeliverable])
  @@index([tenantId, summaryItem])

  // Timeline & scheduling
  @@index([tenantId, scheduledStart])
  @@index([tenantId, scheduledEnd])
  @@index([tenantId, actualStart])
  @@index([tenantId, actualEnd])
  @@index([tenantId, baselineStart])
  @@index([tenantId, forecastEnd])
  @@index([tenantId, deadlineDate])

  // Progress & performance
  @@index([tenantId, percentComplete])
  @@index([tenantId, physicalComplete])
  @@index([tenantId, workComplete])
  @@index([tenantId, schedulePerformanceIndex])
  @@index([tenantId, costPerformanceIndex])

  // Organization & hierarchy
  @@index([tenantId, sequenceOrder])
  @@index([tenantId, displayOrder])
  @@index([tenantId, indentLevel])
  @@index([tenantId, itemCategory])
  @@index([tenantId, grouping])

  // Duration & effort tracking
  @@index([tenantId, plannedDuration])
  @@index([tenantId, actualDuration])
  @@index([tenantId, remainingWork])
  @@index([tenantId, plannedEffort])
  @@index([tenantId, actualEffort])

  // Float & constraint analysis
  @@index([tenantId, totalFloat])
  @@index([tenantId, freeFloat])
  @@index([tenantId, constraintType])
  @@index([tenantId, constraintDate])

  // Resource management
  @@index([tenantId, assignedResources])
  @@index([tenantId, requiredResources])
  @@index([tenantId, resourceUtilization])
  @@index([tenantId, overallocated])
  @@index([tenantId, skillLevel])
  @@index([tenantId, tradeSpecialty])

  // Financial tracking
  @@index([tenantId, totalBudgetedCost])
  @@index([tenantId, totalActualCost])
  @@index([tenantId, earnedValue])
  @@index([tenantId, scheduleVariance])
  @@index([tenantId, costVariance])
  @@index([tenantId, estimateAtCompletion])

  // Risk & issue management
  @@index([tenantId, riskLevel])
  @@index([tenantId, hasActiveIssues])
  @@index([tenantId, issueCount])
  @@index([tenantId, isDelayed])
  @@index([tenantId, delayDays])

  // External factors
  @@index([tenantId, weatherDependent])
  @@index([tenantId, weatherRisk])
  @@index([tenantId, hasExternalDeps])
  @@index([tenantId, permitRequired])
  @@index([tenantId, inspectionRequired])

  // Quality & approval
  @@index([tenantId, qualityScore])
  @@index([tenantId, reworkRequired])
  @@index([tenantId, approvalRequired])
  @@index([tenantId, approvedBy])
  @@index([tenantId, approvedAt])

  // Configuration & behavior
  @@index([tenantId, isActive])
  @@index([tenantId, isTemplate])
  @@index([tenantId, autoSchedule])
  @@index([tenantId, showInGantt])
  @@index([tenantId, showInReports])

  // Status updates & workflow
  @@index([tenantId, lastStatusUpdate])
  @@index([tenantId, nextReviewDate])
  @@index([tenantId, lastCalculated])
  @@index([tenantId, calculationMethod])
  @@index([tenantId, progressMethod])

  // Lifecycle
  @@index([tenantId, deletedAt])

  // Temporal queries (BRIN for time-series performance)
  @@index([createdAt], type: Brin)
  @@index([scheduledStart], type: Brin)
  @@index([actualStart], type: Brin)
  @@index([baselineStart], type: Brin)
  @@index([lastStatusUpdate], type: Brin)

  // Governance & search
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  @@index([tenantId, timezone])
  @@index([metadata], type: Gin)

  @@map("project_schedule_items")
}

model ProjectCriticalPath {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 🔗 Parent Relations (REQUIRED)
  projectId String @db.Uuid
  project   Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  // 📊 Critical Path Analysis
  pathName             String  @db.VarChar(255)
  pathType             String  @default("FORWARD_PASS") @db.VarChar(50) // FORWARD_PASS, BACKWARD_PASS, CRITICAL_CHAIN
  calculationMethod    String  @db.VarChar(100)
  calculationDate      DateTime @db.Timestamptz(6)
  calculatedBy         String? @db.Uuid

  // ⏱️ Duration Analysis
  totalDuration        Int     @default(0) // Duration in hours or days
  totalDurationUnit    String  @default("DAYS") @db.VarChar(20) // HOURS, DAYS, WEEKS
  longestPathDuration  Int     @default(0)
  shortestPathDuration Int     @default(0)

  // 📈 Path Metrics
  totalFloat           Decimal @default(0) @db.Decimal(10, 2) // Total float in path
  freeFloat            Decimal @default(0) @db.Decimal(10, 2) // Free float available
  negativeFloat        Decimal @default(0) @db.Decimal(10, 2) // Behind schedule indicator

  // 🎯 Critical Path Sequence (JSON array of task IDs)
  criticalPathSequence Json    @db.JsonB // Array of task IDs in sequence
  alternativePaths     Json?   @db.JsonB // Alternative critical paths

  // 📊 Impact Analysis
  riskLevel            String  @default("MEDIUM") @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  impactDescription    String?   @db.Text
  recommendedActions   String?   @db.Text
  bufferRecommendation Decimal?  @db.Decimal(10, 2) // Recommended buffer time

  // 📅 Schedule Impact
  earlyStartDate       DateTime? @db.Timestamptz(6)
  earlyFinishDate      DateTime? @db.Timestamptz(6)
  lateStartDate        DateTime? @db.Timestamptz(6)
  lateFinishDate       DateTime? @db.Timestamptz(6)

  // 🔄 Calculation Status
  isValid              Boolean   @default(true)
  lastValidationDate   DateTime? @db.Timestamptz(6)
  validationErrors     Json?     @db.JsonB
  recalculationNeeded  Boolean   @default(false)

  // 📈 Performance Metrics
  schedulePerformanceIndex Decimal? @db.Decimal(8, 4) // SPI
  timeVariance             Decimal? @db.Decimal(10, 2) // TV
  scheduleVariance         Decimal? @db.Decimal(10, 2) // SV

  // 🚨 Alerts & Notifications
  hasSlippedTasks      Boolean   @default(false)
  criticalTaskCount    Int       @default(0)
  atRiskTaskCount      Int       @default(0)
  alertThreshold       Decimal?  @db.Decimal(5, 2) // % threshold for alerts

  // 📊 Lifecycle
  status    String @default("ACTIVE") @db.VarChar(50) // ACTIVE, OUTDATED, ARCHIVED
  version   Int                @default(1)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?          @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs Only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String? @db.Uuid
  dataClassification String  @default("INTERNAL") @db.VarChar(50)
  retentionPolicy    String? @db.VarChar(50)
  metadata           Json?   @db.JsonB
  recordSource       String? @db.VarChar(50)
  timezone           String? @db.VarChar(50)

  // 🗂️ Indexes & Constraints
  @@unique([tenantId, id])
  @@unique([tenantId, projectId, pathName])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
  @@index([tenantId, pathType])
  @@index([tenantId, calculationDate])
  @@index([tenantId, riskLevel])
  @@index([tenantId, isValid])
  @@index([tenantId, hasSlippedTasks])
  @@index([tenantId, recalculationNeeded])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([metadata], type: Gin)
  @@map("project_critical_path")
}

