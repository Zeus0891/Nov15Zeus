  adherenceRate      Decimal  @default(100) @db.Decimal(5, 2) // % compliance

  // Impact metrics
  delayImpact        Int     @default(0) @db.Integer // Hours of delay caused
  costImpact         Decimal @default(0) @db.Decimal(12, 2) // Cost of delays

  // Optimization data
  optimizationScore  Decimal? @db.Decimal(5, 2) // 0-100 optimization score
  canOptimize        Boolean  @default(false)   // Can be optimized
  optimizationNotes  String?  @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🔄 Workflow & Approval
  // ─────────────────────────────────────────────────────────────
  requiresApproval   Boolean   @default(false)
  approvedBy         String?   @db.Uuid // Actor ID
  approvedDate       DateTime? @db.Timestamptz(6)
  approvalNotes      String?   @db.Text

  // Change management
  changeRequestId    String?   @db.Uuid
  lastModifiedBy     String?   @db.Uuid // Actor ID
  modificationReason String?   @db.Text

  // ─────────────────────────────────────────────────────────────
  // 📝 Documentation & Communication
  // ─────────────────────────────────────────────────────────────
  businessJustification String? @db.Text
  technicalRequirements String? @db.Text
  specialInstructions   String? @db.Text
  communicationPlan     String? @db.Text
  stakeholderNotes      String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────

  // Task relationships (using composite keys for multi-tenant)
  dependentTask   ProjectTask @relation("DependentProjectTask", fields: [tenantId, dependentTaskId], references: [tenantId, id], onDelete: Cascade)
  predecessorTask ProjectTask @relation("PredecessorProjectTask", fields: [tenantId, predecessorTaskId], references: [tenantId, id], onDelete: Cascade)

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Strategic Indexes
  // ─────────────────────────────────────────────────────────────
  @@unique([tenantId, id])
  @@unique([tenantId, dependentTaskId, predecessorTaskId]) // No duplicate dependencies

  // Task relationships (most critical for scheduling)
  @@index([tenantId, dependentTaskId])
  @@index([tenantId, predecessorTaskId])

  // Dependency configuration
  @@index([tenantId, dependencyType])
  @@index([tenantId, status])
  @@index([tenantId, isMandatory])
  @@index([tenantId, isExternal])

  // Critical path analysis
  @@index([tenantId, isCriticalPath])
  @@index([tenantId, affectsCriticalPath])

  // Timing & performance
  @@index([tenantId, lagTime])
  @@index([tenantId, leadTime])
  @@index([tenantId, scheduleVariance])
  @@index([tenantId, adherenceRate])

  // Risk management
  @@index([tenantId, riskLevel])
  @@index([tenantId, hasViolations])
  @@index([tenantId, requiresAttention])
  @@index([tenantId, escalatedToManager])

  // Schedule tracking
  @@index([tenantId, predecessorPlannedEnd])
  @@index([tenantId, dependentEarliestStart])
  @@index([tenantId, dependentPlannedStart])

  // Approval workflow
  @@index([tenantId, requiresApproval])
  @@index([tenantId, approvedBy])
  @@index([tenantId, approvedDate])

  // Performance metrics
  @@index([tenantId, delayImpact])
  @@index([tenantId, costImpact])
  @@index([tenantId, optimizationScore])
  @@index([tenantId, canOptimize])

  // Lifecycle
  @@index([tenantId, deletedAt])

  // Temporal queries
  @@index([createdAt], type: Brin)
  @@index([predecessorActualEnd], type: Brin)
  @@index([dependentActualStart], type: Brin)

  // Governance
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  @@index([metadata], type: Gin)

  @@map("project_task_dependencies")
}

model ProjectSchedule {
  // ─────────────────────────────────────────────────────────────
  // 🆔 Identity & Tenant (Pattern A - Child Entity)
  // ─────────────────────────────────────────────────────────────
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📊 Lifecycle & Concurrency
  // ─────────────────────────────────────────────────────────────
  status    ProjectScheduleManagementStatus @default(DRAFT)
  version   Int                             @default(1)
  createdAt DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                        @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?                       @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 👤 Actor Attribution (Pattern A - IDs only for Child Entity)
  // ─────────────────────────────────────────────────────────────
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 🔍 Enterprise Governance
  // ─────────────────────────────────────────────────────────────
  auditCorrelationId String? @db.Uuid
  dataClassification String  @default("CONFIDENTIAL") @db.VarChar(50)
  metadata           Json?   @db.JsonB
  recordSource       String? @db.VarChar(50)
  timezone           String? @db.VarChar(50)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Parent Relationships (Required)
  // ─────────────────────────────────────────────────────────────
  projectId String @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📄 Schedule Identity & Configuration
  // ─────────────────────────────────────────────────────────────
  scheduleName       String  @db.VarChar(255)
  scheduleCode       String? @db.VarChar(50)  // Internal code
  description        String? @db.Text
  scheduleType       String  @default("MASTER") @db.VarChar(50) // MASTER, BASELINE, FORECAST, WHAT_IF

  // Schedule versioning & management
  scheduleVersion    String  @default("1.0") @db.VarChar(20)
  isActive           Boolean @default(true)
  isBaseline         Boolean @default(false)
  isCurrent          Boolean @default(false)
  isPublished        Boolean @default(false)

  // Schedule hierarchy
  parentScheduleId   String? @db.Uuid
  masterScheduleId   String? @db.Uuid
  baselineScheduleId String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📅 Schedule Timeline & Duration
  // ─────────────────────────────────────────────────────────────
  // Overall schedule dates
  scheduledStartDate DateTime? @db.Timestamptz(6)
  scheduledEndDate   DateTime? @db.Timestamptz(6)
  actualStartDate    DateTime? @db.Timestamptz(6)
  actualEndDate      DateTime? @db.Timestamptz(6)

  // Duration in working hours
  plannedDuration    Int?     @db.Integer
  actualDuration     Int?     @db.Integer
  remainingDuration  Int?     @db.Integer

  // Working calendar configuration
  workingDaysPerWeek Decimal @default(5) @db.Decimal(3, 1)
  workingHoursPerDay Decimal @default(8) @db.Decimal(4, 2)

  // Schedule health
  scheduleHealth     String  @default("GREEN") @db.VarChar(20) // GREEN, YELLOW, RED
  completionPercent  Decimal @default(0) @db.Decimal(5, 2)

  // ─────────────────────────────────────────────────────────────
  // 📊 Critical Path & Performance Metrics
  // ─────────────────────────────────────────────────────────────
  // Critical path analysis
  criticalPathDuration    Int?    @db.Integer     // Duration of critical path
  criticalPathTasks       Int     @default(0)     // Number of critical path tasks
  criticalPathFloat       Int     @default(0)     // Total float on critical path

  // Performance indicators
  schedulePerformanceIndex Decimal @default(1.0) @db.Decimal(6, 4) // SPI = EV/PV
  scheduleVariance         Int     @default(0)    @db.Integer       // SV = EV - PV (hours)
  scheduleVariancePercent  Decimal @default(0)    @db.Decimal(8, 4) // SV%

  // Earned value metrics
  plannedValue        Decimal @default(0) @db.Decimal(12, 2) // PV - Budgeted work scheduled
  earnedValue         Decimal @default(0) @db.Decimal(12, 2) // EV - Budgeted work completed
  actualCost          Decimal @default(0) @db.Decimal(12, 2) // AC - Actual cost of work

  // Time-based metrics
  earlyStartDate      DateTime? @db.Timestamptz(6)
  earlyFinishDate     DateTime? @db.Timestamptz(6)
  lateStartDate       DateTime? @db.Timestamptz(6)
  lateFinishDate      DateTime? @db.Timestamptz(6)
  totalFloat          Int       @default(0) @db.Integer // Total float available
  freeFloat           Int       @default(0) @db.Integer // Free float available

  // ─────────────────────────────────────────────────────────────
  // 👥 Resource Management
  // ─────────────────────────────────────────────────────────────
  // Resource allocation
  totalResourceHours     Decimal @default(0) @db.Decimal(12, 2)
  allocatedResourceHours Decimal @default(0) @db.Decimal(12, 2)
  availableResourceHours Decimal @default(0) @db.Decimal(12, 2)

  // Resource utilization
  resourceUtilization    Decimal @default(0) @db.Decimal(5, 2) // % utilization
  overallocatedHours     Decimal @default(0) @db.Decimal(12, 2)
  underallocatedHours    Decimal @default(0) @db.Decimal(12, 2)

  // Team metrics
  assignedTeamMembers    Int     @default(0) @db.Integer
  activeTeamMembers      Int     @default(0) @db.Integer
  requiredSkillsCount    Int     @default(0) @db.Integer
  skillsGapCount         Int     @default(0) @db.Integer

  // ─────────────────────────────────────────────────────────────
  // ⚠️ Risk & Issue Management
  // ─────────────────────────────────────────────────────────────
  // Risk indicators
  overallRiskLevel       String  @default("LOW") @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  scheduleRiskScore      Decimal @default(0) @db.Decimal(5, 2) // 0-100 risk score

  // Issue tracking
  activeIssuesCount      Int     @default(0) @db.Integer
  blockedTasksCount      Int     @default(0) @db.Integer
  delayedTasksCount      Int     @default(0) @db.Integer

  // Weather & external factors
  weatherImpactDays      Int     @default(0) @db.Integer
  externalDelayDays      Int     @default(0) @db.Integer
  contingencyDays        Int     @default(0) @db.Integer
  contingencyUsed        Int     @default(0) @db.Integer

  // ─────────────────────────────────────────────────────────────
  // 📊 Quality & Compliance
  // ─────────────────────────────────────────────────────────────
  // Quality metrics
  qualityGatesTotal      Int     @default(0) @db.Integer
  qualityGatesPassed     Int     @default(0) @db.Integer
  qualityScore           Decimal @default(100) @db.Decimal(5, 2)

  // Compliance tracking
  complianceChecksTotal  Int     @default(0) @db.Integer
  complianceChecksPassed Int     @default(0) @db.Integer
  complianceScore        Decimal @default(100) @db.Decimal(5, 2)

  // Milestone tracking
  milestonesTotal        Int     @default(0) @db.Integer
  milestonesCompleted    Int     @default(0) @db.Integer
  milestoneCompletionRate Decimal @default(0) @db.Decimal(5, 2)

  // ─────────────────────────────────────────────────────────────
  // 🔄 Schedule Updates & Change Management
  // ─────────────────────────────────────────────────────────────
  // Update tracking
  lastUpdateDate         DateTime? @db.Timestamptz(6)
  updateFrequency        String?   @db.VarChar(50) // DAILY, WEEKLY, MONTHLY
  nextUpdateDue          DateTime? @db.Timestamptz(6)

  // Change management
  changeRequestsCount    Int       @default(0) @db.Integer
  approvedChangesCount   Int       @default(0) @db.Integer
  pendingChangesCount    Int       @default(0) @db.Integer

  // Baseline comparison
  varianceFromBaseline   Int       @default(0) @db.Integer // Hours
  baselineRevisionCount  Int       @default(0) @db.Integer
  lastBaselineUpdate     DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 🔔 Notifications & Alerts
  // ─────────────────────────────────────────────────────────────
  enableNotifications    Boolean   @default(true)
  alertThresholds        Json?     @db.JsonB // Custom alert thresholds
  escalationRules        Json?     @db.JsonB // Escalation configuration

  // Alert status
  hasActiveAlerts        Boolean   @default(false)
  criticalAlertsCount    Int       @default(0) @db.Integer
  lastAlertDate          DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 📝 Documentation & Reporting
  // ─────────────────────────────────────────────────────────────
  scheduleNotes          String?   @db.Text
  assumptions            String?   @db.Text
  constraints            String?   @db.Text
  exclusions             String?   @db.Text

  // Reporting configuration
  reportingFrequency     String?   @db.VarChar(50) // DAILY, WEEKLY, MONTHLY
  reportingTemplate      String?   @db.VarChar(100)
  dashboardEnabled       Boolean   @default(true)
  publicReportingEnabled Boolean   @default(false)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────

  // Parent project relationship
  project Project @relation("ProjectToSchedules", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  // Schedule hierarchy
  parentSchedule ProjectSchedule?  @relation("ScheduleHierarchy", fields: [tenantId, parentScheduleId], references: [tenantId, id], onDelete: Restrict)
  childSchedules ProjectSchedule[] @relation("ScheduleHierarchy")

  // Child relations
  scheduleItems ProjectScheduleItem[] @relation("ScheduleToItems")

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Strategic Indexes
  // ─────────────────────────────────────────────────────────────
  @@unique([tenantId, id])
  @@unique([tenantId, projectId, scheduleName]) // Unique schedule names per project

  // Parent relationships
  @@index([tenantId, projectId])
  @@index([tenantId, parentScheduleId])
  @@index([tenantId, masterScheduleId])
  @@index([tenantId, baselineScheduleId])

  // Schedule management
  @@index([tenantId, status])
  @@index([tenantId, scheduleType])
  @@index([tenantId, scheduleVersion])
  @@index([tenantId, isActive])
  @@index([tenantId, isBaseline])
  @@index([tenantId, isCurrent])
  @@index([tenantId, isPublished])

  // Timeline tracking
  @@index([tenantId, scheduledStartDate])
  @@index([tenantId, scheduledEndDate])
  @@index([tenantId, actualStartDate])
  @@index([tenantId, actualEndDate])

  // Performance metrics
  @@index([tenantId, scheduleHealth])
  @@index([tenantId, completionPercent])
  @@index([tenantId, schedulePerformanceIndex])
  @@index([tenantId, scheduleVariance])

  // Critical path
  @@index([tenantId, criticalPathDuration])
  @@index([tenantId, criticalPathTasks])
  @@index([tenantId, totalFloat])

  // Resource management
  @@index([tenantId, resourceUtilization])
  @@index([tenantId, assignedTeamMembers])
  @@index([tenantId, overallocatedHours])

  // Risk & issues
  @@index([tenantId, overallRiskLevel])
  @@index([tenantId, scheduleRiskScore])
  @@index([tenantId, activeIssuesCount])
  @@index([tenantId, blockedTasksCount])

  // Quality & compliance
  @@index([tenantId, qualityScore])
  @@index([tenantId, complianceScore])
  @@index([tenantId, milestoneCompletionRate])

  // Change management
  @@index([tenantId, changeRequestsCount])
  @@index([tenantId, varianceFromBaseline])
  @@index([tenantId, baselineRevisionCount])

  // Alerts & notifications
  @@index([tenantId, hasActiveAlerts])
  @@index([tenantId, criticalAlertsCount])
  @@index([tenantId, enableNotifications])

  // Updates & reporting
  @@index([tenantId, lastUpdateDate])
  @@index([tenantId, nextUpdateDue])
  @@index([tenantId, reportingFrequency])

  // Weather & external factors
  @@index([tenantId, weatherImpactDays])
  @@index([tenantId, contingencyDays])
  @@index([tenantId, contingencyUsed])

  // Lifecycle
  @@index([tenantId, deletedAt])

  // Temporal queries (BRIN for time-series)
  @@index([createdAt], type: Brin)
  @@index([scheduledStartDate], type: Brin)
  @@index([actualStartDate], type: Brin)
  @@index([lastUpdateDate], type: Brin)

  // Governance
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  @@index([tenantId, timezone])

  // JSON searches
  @@index([metadata], type: Gin)
  @@index([alertThresholds], type: Gin)
  @@index([escalationRules], type: Gin)

  @@map("project_schedules")
}

