  schedulePercent Decimal @default(0) @db.Decimal(5, 2) // Schedule progress %
  budgetPercent   Decimal @default(0) @db.Decimal(5, 2) // Budget consumed %
  qualityScore    Decimal? @db.Decimal(4, 1) // Quality score 1-100

  // 📊 Earned Value Management (EVM)
  plannedValue    Decimal @default(0) @db.Decimal(12, 2) // PV - Budgeted cost of scheduled work
  earnedValue     Decimal @default(0) @db.Decimal(12, 2) // EV - Budgeted cost of completed work
  actualCost      Decimal @default(0) @db.Decimal(12, 2) // AC - Actual cost of completed work

  // EVM Performance Indices
  schedulePerformanceIndex Decimal? @db.Decimal(6, 4) // SPI = EV / PV
  costPerformanceIndex     Decimal? @db.Decimal(6, 4) // CPI = EV / AC
  scheduleVariance         Decimal? @db.Decimal(12, 2) // SV = EV - PV
  costVariance             Decimal? @db.Decimal(12, 2) // CV = EV - AC

  // EVM Forecasting
  budgetAtCompletion       Decimal? @db.Decimal(12, 2) // BAC - Total project budget
  estimateAtCompletion     Decimal? @db.Decimal(12, 2) // EAC = BAC / CPI
  estimateToComplete       Decimal? @db.Decimal(12, 2) // ETC = EAC - AC
  varianceAtCompletion     Decimal? @db.Decimal(12, 2) // VAC = BAC - EAC
  toCompletePerformanceIndex Decimal? @db.Decimal(6, 4) // TCPI

  // 📏 Quantities & Units
  totalQuantityPlanned   Decimal? @db.Decimal(12, 4) // Total planned quantity
  totalQuantityCompleted Decimal? @db.Decimal(12, 4) // Total completed quantity
  quantityVariance       Decimal? @db.Decimal(12, 4) // Quantity variance
  quantityUnitOfMeasure  String?  @db.VarChar(50) // Unit of measure

  // 🎯 Phase & Milestone Progress
  totalPhases         Int @default(0) // Total number of phases
  completedPhases     Int @default(0) // Phases completed
  phasesInProgress    Int @default(0) // Phases in progress
  totalMilestones     Int @default(0) // Total milestones
  completedMilestones Int @default(0) // Milestones completed
  milestonesAtRisk    Int @default(0) // Milestones at risk

  // 📅 Schedule Performance
  baselineStartDate   DateTime? @db.Timestamptz(6) // Original start date
  baselineEndDate     DateTime? @db.Timestamptz(6) // Original end date
  currentStartDate    DateTime? @db.Timestamptz(6) // Current start date
  currentEndDate      DateTime? @db.Timestamptz(6) // Current end date
  forecastEndDate     DateTime? @db.Timestamptz(6) // Forecasted end date
  scheduleDrift       Int?      // Days behind/ahead schedule
  criticalPathDays    Int?      // Critical path duration

  // 💰 Financial Progress
  originalBudget      Decimal @default(0) @db.Decimal(12, 2) // Original approved budget
  currentBudget       Decimal @default(0) @db.Decimal(12, 2) // Current approved budget
  budgetConsumed      Decimal @default(0) @db.Decimal(12, 2) // Budget spent to date
  committedCosts      Decimal @default(0) @db.Decimal(12, 2) // Committed but not spent
  forecastAtCompletion Decimal @default(0) @db.Decimal(12, 2) // Final cost forecast
  contingencyUsed     Decimal @default(0) @db.Decimal(12, 2) // Contingency consumed
  changeOrderValue    Decimal @default(0) @db.Decimal(12, 2) // Approved change orders

  // 👥 Resource Performance
  plannedLaborHours   Decimal? @db.Decimal(10, 2) // Planned labor hours
  actualLaborHours    Decimal? @db.Decimal(10, 2) // Actual labor hours
  laborEfficiency     Decimal? @db.Decimal(5, 2) // Labor efficiency %
  averageCrewSize     Decimal? @db.Decimal(4, 1) // Average crew size
  peakCrewSize        Int?     // Peak crew size
  equipmentUtilization Decimal? @db.Decimal(5, 2) // Equipment utilization %

  // ✅ Quality Metrics
  qualityChecksPlanned    Int @default(0) // Quality checks planned
  qualityChecksCompleted  Int @default(0) // Quality checks completed
  qualityIssuesFound      Int @default(0) // Quality issues identified
  qualityIssuesResolved   Int @default(0) // Quality issues resolved
  reworkPercentage        Decimal? @db.Decimal(5, 2) // Rework as % of work
  clientSatisfactionScore Decimal? @db.Decimal(4, 1) // Client satisfaction

  // 🚨 Risk & Issues
  totalRisks          Int @default(0) // Total risks identified
  activeRisks         Int @default(0) // Active risks
  mitigatedRisks      Int @default(0) // Mitigated risks
  totalIssues         Int @default(0) // Total issues
  openIssues          Int @default(0) // Open issues
  resolvedIssues      Int @default(0) // Resolved issues
  criticalIssues      Int @default(0) // Critical issues

  // 🛡️ Safety Performance
  safetyIncidents     Int @default(0) // Safety incidents
  nearMisses          Int @default(0) // Near miss reports
  safetyTrainingHours Decimal? @db.Decimal(6, 2) // Safety training hours
  recordableDays      Int @default(0) // Days without recordable incident
  lostTimeIncidents   Int @default(0) // Lost time incidents

  // 🌤️ Weather & External Factors
  weatherDelays       Int @default(0) // Weather delay days
  weatherImpact       String? @db.Text // Weather impact description
  externalDelays      Int @default(0) // External delay days
  permitDelays        Int @default(0) // Permit-related delays

  // 📊 Performance Trends
  productivityTrend   String? @db.VarChar(50) // IMPROVING, DECLINING, STABLE
  costTrend          String? @db.VarChar(50) // IMPROVING, DECLINING, STABLE
  scheduleTrend      String? @db.VarChar(50) // IMPROVING, DECLINING, STABLE
  qualityTrend       String? @db.VarChar(50) // IMPROVING, DECLINING, STABLE

  // 📝 Progress Notes
  accomplishments     String? @db.Text // Key accomplishments
  upcomingWork       String? @db.Text // Planned upcoming work
  challenges         String? @db.Text // Current challenges
  recommendations    String? @db.Text // Recommendations
  nextReportDate     DateTime? @db.Timestamptz(6) // Next progress report due

  // 👤 Reporting Team
  reportedBy         String? @db.Uuid // Who created report
  reviewedBy         String? @db.Uuid // Who reviewed report
  approvedBy         String? @db.Uuid // Who approved report
  reviewedAt         DateTime? @db.Timestamptz(6)
  approvedAt         DateTime? @db.Timestamptz(6)

  // 📊 Lifecycle
  status    String   @default("DRAFT") @db.VarChar(50) // DRAFT, SUBMITTED, APPROVED
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs Only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String? @db.Uuid
  dataClassification String  @default("INTERNAL") @db.VarChar(50)
  retentionPolicy    String? @db.VarChar(50)
  metadata           Json?   @db.JsonB
  recordSource       String? @db.VarChar(50)
  timezone           String? @db.VarChar(50)

  // 🗂️ Indexes & Constraints
  @@unique([tenantId, id])
  @@unique([tenantId, projectId, reportDate]) // One report per project per date
  @@index([tenantId, projectId])
  @@index([tenantId, reportDate])
  @@index([tenantId, reportType])
  @@index([tenantId, overallPercent])
  @@index([tenantId, schedulePerformanceIndex])
  @@index([tenantId, costPerformanceIndex])
  @@index([tenantId, openIssues])
  @@index([tenantId, criticalIssues])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([metadata], type: Gin)
  @@map("project_progress")
}

model ProjectNote {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 🔗 Parent Relations (REQUIRED)
  projectId String @db.Uuid
  project   Project @relation("ProjectToNotes", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  // 📋 Note Information
  noteTitle       String? @db.VarChar(255) // Note title/subject
  noteContent     String  @db.Text // Main note content
  noteType        String  @default("GENERAL") @db.VarChar(50) // GENERAL, ASSUMPTION, EXCLUSION, CLARIFICATION
  category        String? @db.VarChar(100) // Additional categorization
  priority        String  @default("NORMAL") @db.VarChar(50) // LOW, NORMAL, HIGH, URGENT
  urgency         String? @db.VarChar(50) // Time sensitivity

  // 🔗 Context & Relationships
  taskId          String? @db.Uuid // Related project task
  phaseId         String? @db.Uuid // Related project phase
  milestoneId     String? @db.Uuid // Related milestone
  riskId          String? @db.Uuid // Related risk
  issueId         String? @db.Uuid // Related issue
  decisionId      String? @db.Uuid // Related decision

  // 📝 Threading & Conversations
  parentNoteId    String? @db.Uuid // Parent note for threading
  threadId        String? @db.Uuid // Thread identifier
  isThreadStart   Boolean @default(true) // Starts a new thread
  replyToNoteId   String? @db.Uuid // Direct reply to note
  threadPosition  Int?    // Position in thread

  // 👤 Author & Attribution
  authorId        String? @db.Uuid // Note author
  authorName      String? @db.VarChar(255) // Author name
  authorRole      String? @db.VarChar(100) // Author role on project
  onBehalfOf      String? @db.VarChar(255) // If created on behalf of someone

  // 🔍 Visibility & Access Control
  visibility      String  @default("TEAM") @db.VarChar(50) // PRIVATE, TEAM, CLIENT, PUBLIC
  isPrivate       Boolean @default(false) // Private to author
  isConfidential  Boolean @default(false) // Confidential note
  clientVisible   Boolean @default(false) // Visible to client
  restrictedAccess Boolean @default(false) // Restricted access
  accessList      Json?   @db.JsonB // Array of allowed user IDs

  // 🔔 Mentions & Notifications
  mentions        Json?   @db.JsonB // Array of mentioned user IDs
  notificationsSent Boolean @default(false) // Notifications sent
  requiresResponse Boolean @default(false) // Requires response
  responseBy      DateTime? @db.Timestamptz(6) // Response due date

  // 📎 Status & Workflow
  noteStatus      String  @default("ACTIVE") @db.VarChar(50) // DRAFT, ACTIVE, RESOLVED, ARCHIVED
  workflowState   String? @db.VarChar(50) // Custom workflow state
  requiresApproval Boolean @default(false) // Needs approval
  approvedBy      String? @db.Uuid // Who approved
  approvedAt      DateTime? @db.Timestamptz(6) // When approved
  approvalNotes   String? @db.Text // Approval comments

  // 📝 Rich Text & Formatting
  contentFormat   String  @default("PLAIN_TEXT") @db.VarChar(50) // PLAIN_TEXT, MARKDOWN, HTML
  hasFormatting   Boolean @default(false) // Contains formatting
  wordCount       Int?    // Word count
  characterCount  Int?    // Character count
  readingTime     Int?    // Estimated reading time (minutes)

  // 📎 Tags & Labels
  tags            Json?   @db.JsonB // Searchable tags array
  labels          Json?   @db.JsonB // Organizational labels
  keywords        String? @db.Text // Searchable keywords

  // 📅 Scheduling & Timing
  scheduledDate   DateTime? @db.Timestamptz(6) // Scheduled publication
  effectiveDate   DateTime? @db.Timestamptz(6) // When note becomes effective
  expirationDate  DateTime? @db.Timestamptz(6) // When note expires
  reminderDate    DateTime? @db.Timestamptz(6) // Reminder date

  // 📄 Source & Documentation
  sourceType      String? @db.VarChar(100) // MEETING, EMAIL, PHONE, SITE_VISIT
  sourceReference String? @db.VarChar(255) // Reference to source
  meetingDate     DateTime? @db.Timestamptz(6) // If from meeting
  attendees       Json?   @db.JsonB // Meeting attendees

  // 🔄 Revisions & History
  revisionNumber  Int     @default(1) // Note revision
  isLatestRevision Boolean @default(true) // Latest version flag
  originalNoteId  String? @db.Uuid // Original note if revised
  revisionReason  String? @db.Text // Why revised

  // 📊 Engagement Metrics
  viewCount       Int @default(0) // Times viewed
  likeCount       Int @default(0) // Likes/upvotes
  replyCount      Int @default(0) // Number of replies
  lastViewedAt    DateTime? @db.Timestamptz(6) // Last view time

  // 🔗 Attachments & Links
  hasAttachments  Boolean @default(false) // Has file attachments
  attachmentCount Int     @default(0) // Number of attachments
  hasLinks        Boolean @default(false) // Contains external links
  linkCount       Int     @default(0) // Number of links

  // ✅ Resolution & Follow-up
  isResolved      Boolean @default(false) // Note resolved
  resolvedBy      String? @db.Uuid // Who resolved
  resolvedAt      DateTime? @db.Timestamptz(6) // When resolved
  resolution      String? @db.Text // Resolution details
  followUpRequired Boolean @default(false) // Needs follow-up
  followUpDate    DateTime? @db.Timestamptz(6) // Follow-up due
  followUpWith    String? @db.Uuid // Follow-up assigned to

  // 💰 Business Impact
  impactLevel     String? @db.VarChar(50) // NONE, LOW, MEDIUM, HIGH, CRITICAL
  costImpact      Decimal? @db.Decimal(10, 2) // Financial impact
  scheduleImpact  Int?     // Schedule impact (days)
  actionRequired  Boolean @default(false) // Action required

  // 📊 Lifecycle
  status    String   @default("ACTIVE") @db.VarChar(50)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs Only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String? @db.Uuid
  dataClassification String  @default("INTERNAL") @db.VarChar(50)
  retentionPolicy    String? @db.VarChar(50)
  metadata           Json?   @db.JsonB
  recordSource       String? @db.VarChar(50)
  timezone           String? @db.VarChar(50)

  // 🔗 Self-referencing relations for threading
  parentNote ProjectNote? @relation("NoteThread", fields: [tenantId, parentNoteId], references: [tenantId, id], onDelete: Cascade)
  childNotes ProjectNote[] @relation("NoteThread")
  replyToNote ProjectNote? @relation("NoteReply", fields: [tenantId, replyToNoteId], references: [tenantId, id], onDelete: Cascade)
  replies    ProjectNote[] @relation("NoteReply")

  // 🗂️ Indexes & Constraints
  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@index([tenantId, noteType])
  @@index([tenantId, priority])
  @@index([tenantId, taskId])
  @@index([tenantId, phaseId])
  @@index([tenantId, authorId])
  @@index([tenantId, visibility])
  @@index([tenantId, clientVisible])
  @@index([tenantId, noteStatus])
  @@index([tenantId, requiresApproval])
  @@index([tenantId, parentNoteId])
  @@index([tenantId, threadId])
  @@index([tenantId, isResolved])
  @@index([tenantId, followUpRequired])
  @@index([tenantId, scheduledDate])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([metadata], type: Gin)
  @@index([tags], type: Gin)
  @@map("project_note")
}
