model Invoice {
  // 🆔 Identity & Hybrid Pattern (Pattern BH - Base Hybrid)
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  globalId String @db.Uuid // 1:1:1 traceability with Estimate/Project

  // 📊 Lifecycle
  status    InvoiceStatus @default(DRAFT)
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?     @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern B - Full Relations for Critical Revenue Entity)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  createdByActor Actor? @relation("InvoiceCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  updatedByActor Actor? @relation("InvoiceUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  deletedByActor Actor? @relation("InvoiceDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // 🧠 Governance
  auditCorrelationId String?                      @db.Uuid
  dataClassification InvoiceDataClassification    @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       InvoiceRecordSource?
  metadata           Json?                        @db.JsonB
  timezone           String?                      @db.VarChar(50)

  // 📄 Business Identity
  invoiceNumber      String  @db.VarChar(50)
  invoiceDate        DateTime @default(now()) @db.Timestamptz(6)
  dueDate            DateTime @db.Timestamptz(6)
  title              String? @db.VarChar(255)
  referenceCode      String? @db.VarChar(100)
  description        String? @db.Text
  termsAndConditions String? @db.Text

  // 👥 CRM Linkage (Corrected Model Names)
  crmAccountId     String  @db.Uuid
  crmContactId     String? @db.Uuid
  billToAddressId  String? @db.Uuid

  // 🔗 Source Linkage (1:1:1 Traceability)
  sourceEstimateId String? @db.Uuid // 1:1:1 linkage via globalId
  relatedProjectId String? @db.Uuid // 1:1:1 linkage via globalId  
  contractId       String? @db.Uuid

  // 👤 Ownership & Terms
  ownerMemberId   String? @db.Uuid
  paymentTermsId  String? @db.Uuid

  // 📊 Triple Status Dimension
  paymentStatus    InvoicePaymentStatus    @default(UNPAID)
  collectionStatus InvoiceCollectionStatus @default(CURRENT)

  // 📅 Event Timestamps
  issueDate        DateTime? @db.Timestamptz(6)
  sentToClientAt   DateTime? @db.Timestamptz(6)
  clientViewedAt   DateTime? @db.Timestamptz(6)
  firstPaymentAt   DateTime? @db.Timestamptz(6)
  fullyPaidAt      DateTime? @db.Timestamptz(6)
  voidedAt         DateTime? @db.Timestamptz(6)
  writtenOffAt     DateTime? @db.Timestamptz(6)
  lastReminderAt   DateTime? @db.Timestamptz(6)
  nextReminderAt   DateTime? @db.Timestamptz(6)

  // 💰 Financial Totals (Denormalized for Performance)
  currencyCode              String  @default("USD") @db.Char(3)
  subtotalAmount            Decimal @default(0) @db.Decimal(12, 2)
  discountAmount            Decimal @default(0) @db.Decimal(12, 2)
  taxAmount                 Decimal @default(0) @db.Decimal(12, 2)
  feeAmount                 Decimal @default(0) @db.Decimal(12, 2)
  retainageAmount           Decimal @default(0) @db.Decimal(12, 2) // Construction-specific
  retainagePercentage       Decimal @default(0) @db.Decimal(8, 4) // Construction-specific
  totalAmount               Decimal @default(0) @db.Decimal(12, 2)
  amountPaid                Decimal @default(0) @db.Decimal(12, 2)
  amountDue                 Decimal @default(0) @db.Decimal(12, 2)
  lineItemCount             Int     @default(0)
  totalQuantity             Decimal @default(0) @db.Decimal(10, 4)

  // 📊 Payment Tracking
  lastPaymentDate       DateTime? @db.Timestamptz(6)
  lastPaymentAmount     Decimal   @default(0) @db.Decimal(12, 2)
  paymentCount          Int       @default(0)
  earlyPaymentDiscount  Decimal   @default(0) @db.Decimal(8, 4)

  // 🏗️ Billing Type & Progress
  billingType              InvoiceBillingType @default(STANDARD)
  progressPercentage       Decimal            @default(0) @db.Decimal(8, 4)
  cumulativeBilledAmount   Decimal            @default(0) @db.Decimal(12, 2)
  previouslyBilledAmount   Decimal            @default(0) @db.Decimal(12, 2)
  currentPeriodAmount      Decimal            @default(0) @db.Decimal(12, 2)
  milestoneId              String?            @db.Uuid

  // ⚙️ Behavior Flags
  isRecurring         Boolean @default(false)
  isProgress          Boolean @default(false)
  isMilestone         Boolean @default(false)
  isRetainage         Boolean @default(false)
  isFinal             Boolean @default(false)
  isVoided            Boolean @default(false)
  isWrittenOff        Boolean @default(false)
  autoSendReminders   Boolean @default(true)
  partialPaymentAllowed Boolean @default(true)
  requiresApproval    Boolean @default(false)

  // 🔗 External Module References
  approvalRequestId             String? @db.Uuid
  eSignatureEnvelopeId          String? @db.Uuid
  numberSequenceAllocationId    String? @db.Uuid

  // 🔗 Relations
  tenant Tenant @relation("TenantToInvoice", fields: [tenantId], references: [id], onDelete: Restrict)
  
  // CRM Relations (tenant-to-tenant composite keys)
  crmAccount     CRMAccount? @relation("InvoiceAccount", fields: [tenantId, crmAccountId], references: [tenantId, id], onDelete: Restrict)
  crmContact     CRMContact? @relation("InvoiceContact", fields: [tenantId, crmContactId], references: [tenantId, id], onDelete: SetNull)
  billToAddress  CRMAddress? @relation("InvoiceBillToAddress", fields: [tenantId, billToAddressId], references: [tenantId, id], onDelete: SetNull)

  // Source Relations (1:1:1 traceability)
  sourceEstimate Estimate? @relation("EstimateToInvoices", fields: [tenantId, sourceEstimateId], references: [tenantId, id], onDelete: SetNull)
  relatedProject Project?  @relation("ProjectToInvoices", fields: [tenantId, relatedProjectId], references: [tenantId, id], onDelete: SetNull)

  // Ownership (tenant-to-tenant)
  ownerMember Member? @relation("InvoiceOwner", fields: [tenantId, ownerMemberId], references: [tenantId, id], onDelete: SetNull)

  // External Relations (external modules)
  approvalRequest    ApprovalRequest?    @relation("InvoiceApproval", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: SetNull)
  eSignatureEnvelope ESignatureEnvelope? @relation("InvoiceESignature", fields: [tenantId, eSignatureEnvelopeId], references: [tenantId, id], onDelete: SetNull)

  // 🔗 Child Relations (1:M)
  invoiceLineItems          InvoiceLineItem[]          @relation("InvoiceToLineItems")
  invoiceTaxes              InvoiceTax[]               @relation("InvoiceToTaxes")
  invoiceDiscounts          InvoiceDiscount[]          @relation("InvoiceToDiscounts")
  invoiceFees               InvoiceFee[]               @relation("InvoiceToFees")
  invoiceRetainages         InvoiceRetainage[]         @relation("InvoiceToRetainages")
  invoiceProgresses         InvoiceProgress[]          @relation("InvoiceToProgresses")
  invoiceMilestones         InvoiceMilestone[]         @relation("InvoiceToMilestones")
  invoicePaymentApplications InvoicePaymentApplication[] @relation("InvoiceToPaymentApplications")
  invoiceAttachments        InvoiceAttachment[]        @relation("InvoiceToAttachments")
  invoiceComments           InvoiceComment[]           @relation("InvoiceToComments")
  invoiceRevisions          InvoiceRevision[]          @relation("InvoiceToRevisions")
  invoiceAdjustments        InvoiceAdjustment[]        @relation("InvoiceToAdjustments")
  invoiceCredits            InvoiceCredit[]            @relation("InvoiceToCredits")
  invoiceDebits             InvoiceDebit[]             @relation("InvoiceToDebits")
  invoiceHistories          InvoiceHistory[]           @relation("InvoiceToHistories")
  invoicePublicLinks        InvoicePublicLink[]        @relation("InvoiceToPublicLinks")
  invoiceReminders          InvoiceReminder[]          @relation("InvoiceToReminders")

  // 🗂️ Constraints & Strategic Indexes (35+ indexes per architecture)
  @@unique([tenantId, id])              // Primary constraint
  @@unique([tenantId, globalId])        // Hybrid pattern constraint
  @@unique([tenantId, invoiceNumber])   // Business constraint

  // Global linkage
  @@index([globalId])                   // Cross-tenant 1:1:1 traceability

  // Status filters (most common queries)
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, collectionStatus])

  // Critical business filters
  @@index([tenantId, crmAccountId])     // Customer invoice lists (most common)
  @@index([tenantId, ownerMemberId])    // Ownership queries
  @@index([tenantId, sourceEstimateId]) // 1:1:1 traceability
  @@index([tenantId, relatedProjectId]) // 1:1:1 traceability
  @@index([tenantId, deletedAt])        // Soft delete filtering

  // Temporal indexes (BRIN for performance)
  @@index([invoiceDate], type: Brin)    // Revenue reports
  @@index([dueDate], type: Brin)        // Collections workflow
  @@index([createdAt], type: Brin)      // Audit queries

  // Financial queries
  @@index([tenantId, totalAmount])      // Revenue analysis
  @@index([tenantId, amountDue])        // AR balance queries
  @@index([tenantId, amountPaid])       // Cash reports
  @@index([tenantId, retainageAmount])  // Construction tracking

  // Date-based workflows
  @@index([tenantId, sentToClientAt])
  @@index([tenantId, fullyPaidAt])
  @@index([tenantId, nextReminderAt])   // Reminder scheduling
  @@index([tenantId, lastReminderAt])

  // Governance & analytics
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])

  // CRM lookups
  @@index([tenantId, crmContactId])
  @@index([tenantId, billToAddressId])

  // External module integration
  @@index([tenantId, approvalRequestId])
  @@index([tenantId, eSignatureEnvelopeId])
  @@index([tenantId, contractId])
  @@index([tenantId, milestoneId])

  // Billing type filters
  @@index([tenantId, billingType])
  @@index([tenantId, isProgress])
  @@index([tenantId, isMilestone])
  @@index([tenantId, isRetainage])
  @@index([tenantId, isFinal])

  // Behavior flags
  @@index([tenantId, isVoided])
  @@index([tenantId, isWrittenOff])
  @@index([tenantId, autoSendReminders])

  // Extensibility
  @@index([tenantId, timezone])
  @@index([metadata], type: Gin)       // JSON search

  @@map("invoices")
}

model InvoiceLineItem {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 📊 Lifecycle
  status    InvoiceLineItemStatus @default(ACTIVE)
  version   Int                   @default(1)
  createdAt DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?             @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern B - Critical Business Entity)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  createdByActor Actor? @relation("InvoiceLineItemCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  updatedByActor Actor? @relation("InvoiceLineItemUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  deletedByActor Actor? @relation("InvoiceLineItemDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // 🧠 Governance
  auditCorrelationId String?                      @db.Uuid
  dataClassification InvoiceDataClassification    @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       String?                      @db.VarChar(50)
  metadata           Json?                        @db.JsonB

  // 🔗 Parent Relationship (Required)
  invoiceId String @db.Uuid

  // 💼 Business Fields (Inherited from EstimateLineItem)
  lineNumber            Int     @default(1)
  description           String  @db.Text
  quantity              Decimal @db.Decimal(10, 4)
  unitPrice             Decimal @db.Decimal(12, 2)
  lineTotal             Decimal @db.Decimal(12, 2)
  unitOfMeasure         InvoiceUnitOfMeasure? @default(EACH)
  
  // 🏗️ Construction-specific (inherited from EstimateLineItem)
  laborHours             Decimal? @db.Decimal(10, 2)
  laborRate              Decimal? @db.Decimal(12, 2)
  materialCost           Decimal? @db.Decimal(12, 2)
  equipmentCost          Decimal? @db.Decimal(12, 2)
  subcontractAmount      Decimal? @db.Decimal(12, 2)
  overheadPercentage     Decimal? @db.Decimal(8, 4)
  profitMarginPercentage Decimal? @db.Decimal(8, 4)
  
  // 💰 Cost Analysis (inherited from EstimateLineItem)
  costAmount             Decimal? @db.Decimal(12, 2)
  markupPercentage       Decimal? @db.Decimal(8, 4)
  grossProfit            Decimal? @db.Decimal(12, 2)
  
  // 🔗 Source Traceability
  sourceEstimateLineItemId String? @db.Uuid
  relatedProjectTaskId     String? @db.Uuid
  inventoryItemId          String? @db.Uuid
  
  // 📊 Progress Tracking
  percentComplete       Decimal @default(0) @db.Decimal(8, 4)
  billedToDate         Decimal @default(0) @db.Decimal(12, 2)
  remainingToBill      Decimal @default(0) @db.Decimal(12, 2)
  
  // ⚙️ Flags
  isTaxable            Boolean @default(true)
  isDiscountable       Boolean @default(true)
  requiresApproval     Boolean @default(false)
  
  // 🔗 Relations
  tenant  Tenant  @relation("TenantToInvoiceLineItem", fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation("InvoiceToLineItems", fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  
  // Source relations (optional)
  sourceEstimateLineItem EstimateLineItem? @relation("EstimateLineItemToInvoiceLineItem", fields: [tenantId, sourceEstimateLineItemId], references: [tenantId, id], onDelete: SetNull)
  relatedProjectTask     ProjectTask?      @relation("ProjectTaskToInvoiceLineItem", fields: [tenantId, relatedProjectTaskId], references: [tenantId, id], onDelete: SetNull)
  inventoryItem          InventoryItem?    @relation("InventoryItemToInvoiceLineItem", fields: [tenantId, inventoryItemId], references: [tenantId, id], onDelete: SetNull)

  // 🗂️ Indexes & constraints
  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])           // Parent lookup (most common)
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, sourceEstimateLineItemId]) // Traceability
  @@index([tenantId, relatedProjectTaskId])     // Project integration
  @@index([tenantId, inventoryItemId])          // Inventory lookup
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([metadata], type: Gin)
  @@map("invoice_line_items")
}

model InvoiceTax {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 📊 Lifecycle
  status    InvoiceTaxStatus @default(ACTIVE)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?        @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                   @db.Uuid
  dataClassification InvoiceDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       String?                   @db.VarChar(50)
  metadata           Json?                     @db.JsonB

  // 🔗 Parent Relationship (Required)
  invoiceId String @db.Uuid

  // 💼 Business Fields
  taxName          String  @db.VarChar(100)
  taxType          InvoiceTaxType @default(SALES_TAX)
  taxRate          Decimal @default(0) @db.Decimal(8, 4)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount    Decimal @default(0) @db.Decimal(12, 2)
  jurisdictionCode String? @db.VarChar(20)
  taxCodeId        String? @db.Uuid
  
  // 📊 Compliance
  isExempt         Boolean @default(false)
  exemptionReason  String? @db.VarChar(255)
  exemptionCertId  String? @db.Uuid
  
  // 🔗 Relations
  tenant  Tenant  @relation("TenantToInvoiceTax", fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation("InvoiceToTaxes", fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  
  // Tax system integration (optional)
  taxCode TaxCode? @relation("TaxCodeToInvoiceTax", fields: [tenantId, taxCodeId], references: [tenantId, id], onDelete: SetNull)

  // 🗂️ Indexes & constraints
  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])           // Parent lookup
  @@index([tenantId, deletedAt])
  @@index([tenantId, taxCodeId])           // Tax system integration
  @@index([tenantId, jurisdictionCode])    // Jurisdiction reporting
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([metadata], type: Gin)
  @@map("invoice_taxes")
}

model InvoiceDiscount {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 📊 Lifecycle
  status    InvoiceDiscountStatus @default(ACTIVE)
  version   Int                   @default(1)
  createdAt DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?             @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                   @db.Uuid
  dataClassification InvoiceDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       String?                   @db.VarChar(50)
  metadata           Json?                     @db.JsonB

  // 🔗 Parent Relationship (Required)
  invoiceId String @db.Uuid

  // 💼 Business Fields
  discountName        String               @db.VarChar(100)
  discountType        InvoiceDiscountType  @default(AMOUNT)
  discountRate        Decimal              @default(0) @db.Decimal(8, 4)
  discountAmount      Decimal              @default(0) @db.Decimal(12, 2)
  maximumAmount       Decimal?             @db.Decimal(12, 2)
  applicableAmount    Decimal              @default(0) @db.Decimal(12, 2)
  
  // 📅 Terms & Conditions
  earlyPaymentDays    Int?     // Days for early payment discount
  validFrom          DateTime? @db.Timestamptz(6)
  validUntil         DateTime? @db.Timestamptz(6)
  description        String?   @db.Text
  
  // ✅ Approval Workflow (Member approval for discounts)
  requiresApproval   Boolean @default(true)
  approvedByMemberId String? @db.Uuid
  approvedAt         DateTime? @db.Timestamptz(6)
  approvalNotes      String?   @db.Text
  
  // 🔗 Relations
  tenant  Tenant  @relation("TenantToInvoiceDiscount", fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation("InvoiceToDiscounts", fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  
  // Member approval workflow (tenant-scoped composite key)
  approvedByMember Member? @relation("InvoiceDiscountApprover", fields: [tenantId, approvedByMemberId], references: [tenantId, id], onDelete: SetNull)

  // 🗂️ Indexes & constraints
  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])           // Parent lookup
  @@index([tenantId, deletedAt])
  @@index([tenantId, approvedByMemberId])  // Approval workflow
  @@index([tenantId, requiresApproval])    // Pending approvals
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([metadata], type: Gin)
  @@map("invoice_discounts")
}

model InvoiceFee {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 📊 Lifecycle
  status    InvoiceFeeStatus @default(ACTIVE)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?        @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                   @db.Uuid
  dataClassification InvoiceDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       String?                   @db.VarChar(50)
  metadata           Json?                     @db.JsonB

  // 🔗 Parent Relationship (Required)
  invoiceId String @db.Uuid

  // 💼 Business Fields
  feeName         String          @db.VarChar(100)
  feeType         InvoiceFeeType  @default(PROCESSING_FEE)
  feeAmount       Decimal         @default(0) @db.Decimal(12, 2)
  feeRate         Decimal?        @db.Decimal(8, 4)
  applicableAmount Decimal        @default(0) @db.Decimal(12, 2)
  
  // 📅 Late Fee Specifics
  daysPastDue     Int?            // For late fees
  gracePeriodDays Int?            // Grace period before applying
  maximumAmount   Decimal?        @db.Decimal(12, 2)
  
  // 📊 Calculation Details
  calculationBasis InvoiceFeeCalculationBasis? @default(TOTAL_AMOUNT)
  description      String?                      @db.Text
  isRecurring      Boolean                      @default(false)
  
  // ✅ Approval Workflow (Member approval for fees)
  requiresApproval   Boolean   @default(false)
  approvedByMemberId String?   @db.Uuid
  approvedAt         DateTime? @db.Timestamptz(6)
  approvalNotes      String?   @db.Text
  
