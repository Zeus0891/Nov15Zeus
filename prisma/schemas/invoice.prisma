  // Member approval workflow (tenant-scoped composite key)
  approvedByMember Member? @relation("InvoiceFeeApprover", fields: [tenantId, approvedByMemberId], references: [tenantId, id], onDelete: SetNull)

  // 🗂️ Indexes & constraints
  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])           // Parent lookup
  @@index([tenantId, deletedAt])
  @@index([tenantId, feeType])             // Fee type filtering
  @@index([tenantId, approvedByMemberId])  // Approval workflow
  @@index([tenantId, requiresApproval])    // Pending approvals
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([metadata], type: Gin)
  @@map("invoice_fees")
}

model InvoiceRetainage {
  // 🆔 Identity & Tenant
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 📊 Lifecycle
  status    InvoiceRetainageStatus @default(WITHHELD)
  version   Int                    @default(1)
  createdAt DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?              @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern A - IDs only)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                   @db.Uuid
  dataClassification InvoiceDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       String?                   @db.VarChar(50)
  metadata           Json?                     @db.JsonB

  // 🔗 Parent Relationship (Required)
  invoiceId String @db.Uuid

  // 💼 Retainage Business Fields
  retainageType        InvoiceRetainageType @default(PERCENTAGE)
  retainageRate        Decimal              @default(0) @db.Decimal(8, 4) // e.g., 10.00% = 0.1000
  retainageAmount      Decimal              @default(0) @db.Decimal(12, 2)
  baseAmount           Decimal              @default(0) @db.Decimal(12, 2) // Amount retainage is calculated on
  
  // 📊 Cumulative Tracking
  cumulativeRetainage  Decimal              @default(0) @db.Decimal(12, 2)
  previousRetainage    Decimal              @default(0) @db.Decimal(12, 2)
  currentRetainage     Decimal              @default(0) @db.Decimal(12, 2)
  
  // 🔓 Release Management
  releaseType          InvoiceRetainageReleaseType? @default(NONE)
  releasedAmount       Decimal              @default(0) @db.Decimal(12, 2)
  remainingRetainage   Decimal              @default(0) @db.Decimal(12, 2)
  releaseDate          DateTime?            @db.Timestamptz(6)
  releaseApprovedAt    DateTime?            @db.Timestamptz(6)
  releaseApprovedBy    String?              @db.Uuid
  
  // 📋 Release Conditions
  releaseConditions    String?              @db.Text
