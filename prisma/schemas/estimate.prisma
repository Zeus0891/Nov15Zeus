  @@index([tenantId, estimateId]) // List all sections for an estimate
  @@index([tenantId, estimateId, displayOrder]) // Ordered section list
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, parentSectionId]) // Hierarchy navigation
  @@index([tenantId, nestingLevel]) // Level-based queries
  @@index([tenantId, isOptional]) // Filter optional sections
  @@index([tenantId, isIncludedInTotal]) // Financial calculations
  @@index([tenantId, convertedToProjectPhaseId]) // Conversion tracking
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([metadata], type: Gin)
  @@map("estimate_sections")
