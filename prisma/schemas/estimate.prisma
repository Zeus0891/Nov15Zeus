  // ⚙️ Business Flags & Behavior
  // ─────────────────────────────────────────────────────────────

  /// If true, this line item is taxable
  isTaxable Boolean @default(true)

  /// If true, this line item can be modified during project execution
  allowModification Boolean @default(true)

  /// If true, this is a material item (vs labor/service)
  isMaterial Boolean @default(false)

  /// If true, this requires special handling or approval
  requiresApproval Boolean @default(false)

  /// If true, this line item is a standard/template item
  isStandardItem Boolean @default(false)

  /// Optional vendor/supplier for this line item
  preferredVendorId String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📝 Additional Information
  // ─────────────────────────────────────────────────────────────

  /// Technical notes or specifications
  technicalNotes String? @db.Text

  /// Installation instructions or requirements
  installationNotes String? @db.Text

  /// Warranty information for this item
  warrantyInfo String? @db.Text

  /// Special terms or conditions for this line item
  specialTerms String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations to Tenant & Actors
  // ─────────────────────────────────────────────────────────────

  tenant         Tenant @relation("TenantToEstimateLineItem", fields: [tenantId], references: [id], onDelete: Cascade)
  createdByActor Actor? @relation("EstimateLineItemCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  updatedByActor Actor? @relation("EstimateLineItemUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  deletedByActor Actor? @relation("EstimateLineItemDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Parent Relations
  // ─────────────────────────────────────────────────────────────

  /// Parent estimate (CASCADE - line items belong to estimate)
  estimate Estimate @relation(fields: [tenantId, estimateId], references: [tenantId, id], onDelete: Cascade)

  /// Optional section grouping (SetNull - can exist without section)
  section EstimateSection? @relation("EstimateLineItemToSection", fields: [tenantId, sectionId], references: [tenantId, id], onDelete: SetNull)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Child Relations (Critical Feature: Up to 5 attachments per line)
  // ─────────────────────────────────────────────────────────────

  /// Line-item scoped attachments (up to 5 images/documents)
  /// These are inherited to ProjectTaskAttachment on project creation
  attachments EstimateAttachment[] @relation("EstimateLineItemAttachments")
  
  /// Comments related to this specific line item
  comments EstimateComment[] @relation("EstimateCommentLineItem")
  
  /// History events for this line item
  historyEvents EstimateHistoryEvent[] @relation("HistoryEventLineItem")

  // ─────────────────────────────────────────────────────────────
  // 🔗 Cross-Module Relations (via inheritance to Project/Invoice)
  // ─────────────────────────────────────────────────────────────

  /// Project tasks created from this line item (conceptual)
  // projectTasks ProjectTask[] @relation("EstimateLineItemToProjectTasks")

  /// Invoice line items created from this line item (actual relation)
  invoiceLineItems InvoiceLineItem[] @relation("EstimateLineItemToInvoiceLineItem")

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes
  // ─────────────────────────────────────────────────────────────

  // Primary constraints
  @@unique([tenantId, id])

  // Parent relationship indexes
  @@index([tenantId, estimateId]) // Line items for estimate
  @@index([tenantId, sectionId]) // Line items for section
  @@index([tenantId, estimateId, sortOrder]) // Ordered line items

  // Business filtering
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, productCode])
  @@index([tenantId, deletedAt])

  // Financial analysis
  @@index([tenantId, lineTotal]) // Value-based filtering
  @@index([tenantId, isTaxable]) // Tax calculations
  @@index([tenantId, isMaterial]) // Material vs labor analysis

  // Integration lookups
  @@index([tenantId, costCodeId]) // Job costing integration
  @@index([tenantId, inventoryItemId]) // Inventory integration
  @@index([tenantId, serviceCatalogItemId]) // Service catalog integration
  @@index([tenantId, preferredVendorId]) // Vendor analysis

  // Time-based queries (BRIN for temporal clustering)
  @@index([createdAt], type: Brin)
  @@index([updatedAt], type: Brin)

  // Governance & analytics
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])

  // Business flags for filtering
  @@index([tenantId, requiresApproval])
  @@index([tenantId, isStandardItem])
  @@index([tenantId, allowModification])

  // Project scheduling support
  @@index([tenantId, estimatedStartDate])
  @@index([tenantId, estimatedHours])

  // JSON metadata search
  @@index([metadata], type: Gin)

  @@map("estimate_line_items") // Plural table name
}

model EstimateTax {
