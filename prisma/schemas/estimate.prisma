  // ─────────────────────────────────────────────────────────────
  // 🔗 Parent Relations
  // ─────────────────────────────────────────────────────────────

  /// Header-level attachment (optional)
  estimate Estimate? @relation(fields: [tenantId, estimateId], references: [tenantId, id], onDelete: Cascade)

  /// Line-item scoped attachment (critical feature - up to 5 per line)
  lineItem EstimateLineItem? @relation("EstimateLineItemAttachments", fields: [tenantId, lineItemId], references: [tenantId, id], onDelete: Cascade)

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes
  // ─────────────────────────────────────────────────────────────

  @@unique([tenantId, id])
  
  // Parent relationship indexes
  @@index([tenantId, estimateId]) // Header attachments
  @@index([tenantId, lineItemId]) // Line item attachments
  @@index([tenantId, estimateId, sortOrder]) // Ordered header attachments
  @@index([tenantId, lineItemId, sortOrder]) // Ordered line attachments

  // Business filtering
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isPublic])
  @@index([tenantId, isRequired])

  // File management
  @@index([tenantId, mimeType]) // File type filtering
  @@index([tenantId, fileSize]) // Size-based queries
  @@index([tenantId, fileHash]) // Duplicate detection

  // Time-based queries (BRIN for temporal clustering)
  @@index([createdAt], type: Brin)
  @@index([updatedAt], type: Brin)

  // Governance & analytics
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])

  // JSON metadata search
  @@index([metadata], type: Gin)

  @@map("estimate_attachments") // Plural table name
}

model EstimateComment {
