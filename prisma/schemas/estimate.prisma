  @@index([tenantId, clientApproved]) // Approval tracking
  @@index([tenantId, clientDeclined]) // Decline tracking
  @@index([tenantId, viewCount]) // Engagement analytics
  @@index([tenantId, sentAt]) // Communication timeline
  @@index([tenantId, firstViewedAt]) // First engagement
  @@index([tenantId, lastViewedAt]) // Recent activity
  @@index([tenantId, clientDecisionAt]) // Decision timeline
  @@index([tenantId, clientEmail]) // Client lookup
  @@index([tenantId, requiresAuthentication]) // Security filtering
  @@index([tenantId, customTheme]) // Theme analytics
  @@index([tenantId, sendReminders]) // Reminder management
  @@index([tenantId, notifyOnClientAction]) // Notification settings
  @@index([tenantId, eSignatureEnvelopeId]) // E-signature integration
  @@index([tenantId, estimateRevisionId]) // Revision linkage
  @@index([createdAt], type: Brin) // Temporal clustering
