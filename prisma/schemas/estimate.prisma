  /// Materials cost comparison
  materialCostComparison Decimal? @db.Decimal(12, 2)

  /// Equipment cost comparison
  equipmentCostComparison Decimal? @db.Decimal(12, 2)

  /// Overhead comparison
  overheadComparison Decimal? @db.Decimal(12, 2)

  /// Profit margin comparison
