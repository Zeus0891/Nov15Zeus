  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // 📊 Lifecycle
  status    String    @default("ACTIVE")
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // 👤 Minimal audit (UUIDs; Actor relations only for CRITICAL PARENT entities)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String? @db.Uuid
  dataClassification String  @default("INTERNAL") @db.VarChar(50)
  // retentionPolicy    RetentionPolicy?  // descomenta si tu módulo lo usa

  // 🔎 Observability (OPTIONAL: enable only if it adds real value)
  // traceId      String? @db.VarChar(64)
  // spanId       String? @db.VarChar(32)
  // authContext  String? @db.Text
  // hashToken    String? @db.VarChar(255) // add per-tenant index if you query it
  // metadata     Json?   @db.JsonB
  // recordSource String? @db.VarChar(50)  // API, IMPORT, SYSTEM
  // timezone     String? @db.VarChar(50)

  // 🔗 Required relations
  // tenant Tenant @relation("TenantToEstimateComment", fields: [tenantId], references: [id], onDelete: Cascade)

  // 👥 Actor relations (ENABLE ONLY for CRITICAL PARENT entities)
  // createdByActor Actor? @relation("EstimateCommentCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  // updatedByActor Actor? @relation("EstimateCommentUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  // deletedByActor Actor? @relation("EstimateCommentDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // Enable ONLY if you use these fields:
  // @@index([tenantId, hashToken])
  // @@index([tenantId, recordSource])
  // @@index([tenantId, timezone])
  // @@index([metadata], type: Gin)
  estimate   Estimate? @relation(fields: [estimateId], references: [id])
  estimateId String?   @db.Uuid

  // 🗂️ Indexes & constraints (tenant-first)
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([createdAt], type: Brin)
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@map("estimate_comment")
}

