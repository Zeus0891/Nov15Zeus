  competitorTimelineDays Int? @db.Integer

  /// Our proposed timeline (in days)
  ourTimelineDays Int? @db.Integer

  /// Schedule difference (positive = we're faster, negative = we're slower)
  scheduleDifference Int? @db.Integer

  /// Schedule competitiveness assessment
  scheduleCompetitiveness EstimateCompetitiveness @default(COMPETITIVE)

  /// Delivery date comparison
  deliveryDateComparison DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 🏗️ Technical & Quality Comparison
  // ─────────────────────────────────────────────────────────────

  /// Technical approach comparison notes
  technicalComparison String? @db.Text

  /// Quality level comparison
  qualityLevelComparison EstimateQualityLevel? 

  /// Technology/methods comparison
  technologyComparison String? @db.Text

  /// Innovation factor assessment
  innovationFactor EstimateInnovationLevel @default(STANDARD)

  /// Sustainability/environmental comparison
  sustainabilityComparison String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🎯 Competitive Scoring & Analysis
  // ─────────────────────────────────────────────────────────────

  /// Overall competitive score (1-100)
  competitiveScore Int? @db.Integer

  /// Price score component (1-100)
  priceScore Int? @db.Integer

  /// Quality score component (1-100)
  qualityScore Int? @db.Integer

  /// Timeline score component (1-100)
  timelineScore Int? @db.Integer

  /// Experience/reputation score (1-100)
  experienceScore Int? @db.Integer

  /// Innovation score (1-100)
  innovationScore Int? @db.Integer

  /// Risk assessment score (1-100, higher = lower risk)
  riskScore Int? @db.Integer

  // ─────────────────────────────────────────────────────────────
  // ⚠️ Risk & Opportunity Analysis
  // ─────────────────────────────────────────────────────────────

  /// Competitive risk level
  competitiveRisk EstimateRiskLevel @default(MEDIUM)

  /// Risk factors identified
  riskFactors String? @db.Text

  /// Opportunities identified
  opportunities String? @db.Text

  /// Threats identified
  threats String? @db.Text

  /// Mitigation strategies
  mitigationStrategies String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 💡 Strategic Insights & Recommendations
  // ─────────────────────────────────────────────────────────────

  /// Key differentiators vs competitor
  keyDifferentiators String? @db.Text

  /// Competitive advantages we have
  competitiveAdvantages String? @db.Text

  /// Areas where competitor is stronger
  competitorStrengths String? @db.Text

  /// Recommended strategy against this competitor
  recommendedStrategy String? @db.Text

  /// Action items to improve competitiveness
  actionItems String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 📈 Market & Client Intelligence
  // ─────────────────────────────────────────────────────────────

  /// Client's preference indicators
  clientPreference EstimateClientPreference? 

  /// Market positioning assessment
  marketPosition EstimateMarketPosition @default(COMPETITIVE)

  /// Win probability against this competitor
  winProbability Decimal? @db.Decimal(5, 2)

  /// Historical win/loss rate against this competitor
  historicalWinRate Decimal? @db.Decimal(5, 2)

  /// Market share context
  marketShareContext String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🔍 Validation & Verification
  // ─────────────────────────────────────────────────────────────

  /// Whether competitor data has been verified
  isDataVerified Boolean @default(false)

  /// Who verified the competitor data
  verifiedBy String? @db.VarChar(200)

  /// When data was verified
  verifiedAt DateTime? @db.Timestamptz(6)

  /// Verification method or source
  verificationMethod String? @db.VarChar(200)

  /// Verification notes
  verificationNotes String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 📊 Outcome & Follow-up
  // ─────────────────────────────────────────────────────────────

  /// Final recommendation based on comparison
  finalRecommendation EstimateRecommendationLevel? 

  /// Whether to proceed with our estimate
  recommendProceed Boolean? 

  /// Suggested estimate adjustments
  suggestedAdjustments String? @db.Text

  /// Follow-up actions required
  followupActions String? @db.Text

  /// Comparison outcome (won/lost/pending)
  outcome EstimateComparisonOutcome? 

  /// Outcome date (when result was determined)
  outcomeDate DateTime? @db.Timestamptz(6)

  /// Lessons learned from this comparison
  lessonsLearned String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────

  tenant   Tenant   @relation("TenantToEstimateComparison", fields: [tenantId], references: [id], onDelete: Cascade)
  estimate Estimate @relation(fields: [tenantId, estimateId], references: [tenantId, id], onDelete: Cascade)

  // Actor relations: Pattern A (IDs only) - no cross-relations for supporting entities

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes
  // ─────────────────────────────────────────────────────────────

  @@unique([tenantId, id])
  @@index([tenantId, estimateId]) // Parent relationship
  @@index([tenantId, status]) // Status filtering
  @@index([tenantId, comparisonType]) // Type filtering
  @@index([tenantId, category]) // Category filtering
  @@index([tenantId, competitorName]) // Competitor lookup
  @@index([tenantId, informationSource]) // Source filtering
  @@index([tenantId, dataReliability]) // Reliability filtering
  @@index([tenantId, deletedAt]) // Soft delete filtering
  @@index([tenantId, priceCompetitiveness]) // Price analysis
  @@index([tenantId, scheduleCompetitiveness]) // Schedule analysis
  @@index([tenantId, competitiveRisk]) // Risk assessment
  @@index([tenantId, marketPosition]) // Market positioning
  @@index([tenantId, competitiveScore]) // Scoring analysis
  @@index([tenantId, winProbability]) // Win probability
  @@index([tenantId, clientPreference]) // Client insights
  @@index([tenantId, isDataVerified]) // Verification status
  @@index([tenantId, finalRecommendation]) // Recommendations
  @@index([tenantId, recommendProceed]) // Proceed decisions
  @@index([tenantId, outcome]) // Outcome tracking
  @@index([tenantId, outcomeDate]) // Outcome timeline
  @@index([tenantId, innovationFactor]) // Innovation tracking
  @@index([createdAt], type: Brin) // Temporal clustering
  @@index([tenantId, auditCorrelationId]) // Governance
  @@index([tenantId, sortOrder]) // Display ordering
  @@index([tenantId, informationDate]) // Information timeline
  @@map("estimate_comparisons")
}

