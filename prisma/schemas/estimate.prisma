  estimatedHours Decimal? @db.Decimal(8, 2)

  /// Estimated duration in days for scheduling
  estimatedDurationDays Decimal? @db.Decimal(6, 2)

  /// Estimated start date for project scheduling
  estimatedStartDate DateTime? @db.Timestamptz(6)

  /// Estimated completion date for project scheduling
