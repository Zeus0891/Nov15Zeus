/// Template categories for reusable estimates
enum EstimateTemplateCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  FLOORING
  ROOFING
  PAINTING
  CARPENTRY
  LANDSCAPING
  CONCRETE
  MASONRY
  GENERAL_CONTRACTING
  SPECIALTY_TRADE
  MAINTENANCE
  RENOVATION
  NEW_CONSTRUCTION
  CUSTOM
}

/// Communication methods for client interaction
enum EstimateCommunicationMethod {
  EMAIL
  SMS
  PORTAL
  PHONE
  IN_PERSON
  MAIL
}

/// Record source tracking for data lineage
enum EstimateRecordSource {
  API // Created via API
  IMPORT // Imported from external system
  SYSTEM // Auto-generated by system
  MANUAL // Manually created by user
  MIGRATION // Data migration
  INTEGRATION // External integration
}

/// Revision status lifecycle
enum EstimateRevisionStatus {
  ACTIVE // Current working revision
  PUBLISHED // Published/sent to client
  ARCHIVED // Archived/superseded revision
  DRAFT // Draft revision
  DELETED // Soft deleted
}

/// Section status lifecycle
enum EstimateSectionStatus {
  ACTIVE // Active section
  INACTIVE // Temporarily disabled
  ARCHIVED // Archived section
  DELETED // Soft deleted
}

/// Line item status lifecycle  
enum EstimateLineItemStatus {
  ACTIVE // Active line item
  INACTIVE // Temporarily disabled
  ON_HOLD // On hold pending approval/materials
  CANCELED // Canceled line item
  COMPLETED // Completed work
  DELETED // Soft deleted
}

/// Line item categories for classification
enum EstimateLineItemCategory {
  LABOR // Labor/service work
  MATERIAL // Materials/products
  EQUIPMENT // Equipment rental/purchase
  SUBCONTRACTOR // Subcontractor services
  PERMIT // Permits and fees
  TRAVEL // Travel expenses
  OVERHEAD // Overhead costs
  CONTINGENCY // Contingency allowance
  MARKUP // Markup/profit
  TAX // Tax items
  DISCOUNT // Discount items
  MISCELLANEOUS // Other items
}

/// Units of measure for quantities
enum EstimateUnitOfMeasure {
  // Quantity units
  EACH // Each (individual items)
  PIECE // Pieces
  PAIR // Pairs
  SET // Sets
  KIT // Kits
  LOT // Lots
  
  // Time units
  HOUR // Hours
  DAY // Days
  WEEK // Weeks
  MONTH // Months
  
  // Linear measurements
  FOOT // Feet
  METER // Meters
  INCH // Inches
  YARD // Yards
  MILE // Miles
  
  // Area measurements
  SQ_FT // Square feet
  SQ_METER // Square meters
  SQ_YARD // Square yards
  SQ_INCH // Square inches
  ACRE // Acres
  
  // Volume measurements
  CU_FT // Cubic feet
  CU_METER // Cubic meters
  CU_YARD // Cubic yards
  GALLON // Gallons
  LITER // Liters
  
  // Weight measurements
  POUND // Pounds
