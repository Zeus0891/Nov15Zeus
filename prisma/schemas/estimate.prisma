  /// File display name (can be renamed by user)
  displayName String? @db.VarChar(255)

  /// File description/caption
  description String? @db.Text

  /// MIME type (e.g., image/jpeg, application/pdf)
  mimeType String @db.VarChar(100)

  /// File size in bytes
  fileSize Int @db.Integer

  /// Storage path or URL where file is stored
  storagePath String @db.Text

  /// File hash for duplicate detection and integrity
  fileHash String? @db.VarChar(64)

  // ─────────────────────────────────────────────────────────────
  // 🖼️ Image-Specific Metadata (if applicable)
