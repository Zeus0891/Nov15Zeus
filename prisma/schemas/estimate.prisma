  @@index([tenantId, category]) // Category filtering
  @@index([tenantId, priority]) // Priority sorting
  @@index([tenantId, visibility]) // Visibility filtering
  @@index([tenantId, deletedAt]) // Soft delete filtering
  @@index([tenantId, lineItemId]) // Line item context
  @@index([tenantId, sectionId]) // Section context
  @@index([tenantId, parentCommentId]) // Threading
  @@index([tenantId, rootCommentId]) // Thread roots
  @@index([tenantId, threadLevel]) // Thread depth
  @@index([tenantId, isVisibleToClient]) // Client visibility
  @@index([tenantId, requiresResponse]) // Attention needed
  @@index([tenantId, isPinned]) // Pinned comments
  @@index([tenantId, isActionItem]) // Action items
  @@index([tenantId, actionStatus]) // Action tracking
  @@index([tenantId, actionDueDate]) // Action scheduling
  @@index([tenantId, assignedToMemberId]) // Assignment lookup
  @@index([tenantId, isResolved]) // Resolution tracking
  @@index([tenantId, resolvedAt]) // Resolution timeline
  @@index([tenantId, isConfidential]) // Confidential filtering
  @@index([tenantId, lastActivityAt]) // Activity sorting
  @@index([createdAt], type: Brin) // Temporal clustering
  @@index([tenantId, auditCorrelationId]) // Governance
  @@index([tenantId, sortOrder]) // Display ordering
  @@index([tenantId, approvalRequestId]) // Approval linkage
  @@index([tenantId, changeOrderId]) // Change order linkage
  @@map("estimate_comments")
