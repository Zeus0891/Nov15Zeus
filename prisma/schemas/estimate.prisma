  // ─────────────────────────────────────────────────────────────

  /// Job costing integration (optional cost code reference)
  costCodeId String? @db.Uuid

  /// Inventory item reference (for material tracking)
  inventoryItemId String? @db.Uuid

  /// Service catalog reference (for standardized services)
  serviceCatalogItemId String? @db.Uuid

