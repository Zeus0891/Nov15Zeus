// ============================================================================
// PROJECT ENUMS
// ============================================================================

/// Primary business workflow status
enum ProjectStatus {
  PLANNING // Planning phase, not yet started
  PENDING_APPROVAL // Submitted for approval
  APPROVED // Approved, ready to start
  ACTIVE // Work in progress
  ON_HOLD // Temporarily paused
  DELAYED // Behind schedule
  AT_RISK // At risk of failure
  COMPLETED // Work completed, awaiting closeout
  CLOSED // Project closed
  CANCELLED // Project cancelled
  DELETED // Soft deleted
}

/// Budget status dimension
enum ProjectBudgetStatus {
  ON_BUDGET // Within budget
  UNDER_BUDGET // Under budget
  APPROACHING_BUDGET // 90-100% of budget
  OVERBUDGET // Over budget
  CRITICAL // Significantly over budget (>110%)
}

/// Schedule status dimension
enum ProjectScheduleStatus {
  ON_SCHEDULE // On track
  AHEAD_OF_SCHEDULE // Ahead of schedule
  MINOR_DELAY // 1-7 days delayed
  DELAYED // >7 days delayed
  CRITICAL // Significantly delayed (>30 days)
}

/// Data classification for governance
enum ProjectDataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

/// Record source tracking for data lineage
enum ProjectRecordSource {
  API
  IMPORT
  SYSTEM
  MANUAL
  MIGRATION
}

// ============================================================================
// PROJECT PHASE ENUMS
// ============================================================================

/// Phase status lifecycle
enum PhaseStatus {
  NOT_STARTED // Phase not yet started
  IN_PROGRESS // Phase in progress
  ON_HOLD // Phase temporarily paused
  COMPLETED // Phase completed
  CANCELLED // Phase cancelled
  BLOCKED // Phase blocked by dependencies
}

/// Phase risk assessment levels
enum PhaseRiskLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  CRITICAL
}

// ============================================================================
// PROJECT MILESTONE ENUMS
// ============================================================================

/// Milestone status lifecycle
enum ProjectMilestoneStatus {
  PENDING // Milestone pending start
  IN_PROGRESS // Milestone work in progress
  COMPLETED // Milestone completed
  OVERDUE // Milestone overdue
  CANCELLED // Milestone cancelled
  ON_HOLD // Milestone on hold
}

/// Milestone type classification
enum ProjectMilestoneType {
  DELIVERABLE // Deliverable milestone
  PAYMENT // Payment milestone
  APPROVAL // Approval milestone
  INSPECTION // Inspection milestone
  PHASE_GATE // Phase gate milestone
  DECISION_POINT // Decision point
  REVIEW // Review milestone
  COMPLIANCE // Compliance checkpoint
}

/// Risk assessment levels for milestones
enum ProjectRiskLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  CRITICAL
}

// ============================================================================
// PROJECT TEAM MEMBER ENUMS
// ============================================================================

/// Team member status lifecycle
