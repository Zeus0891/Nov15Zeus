  // ─────────────────────────────────────────────────────────────
  documentationRequired Boolean   @default(false)
  documentationComplete Boolean   @default(false)
  clientNotified        Boolean   @default(false)
  lastNotificationAt    DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // ⚙️ Business Flags (Core Only)
  // ─────────────────────────────────────────────────────────────
  isCritical         Boolean @default(false)
  isOptional         Boolean @default(false)
  autoTriggerInvoice Boolean @default(false)

  // ─────────────────────────────────────────────────────────────
  // 🔗 External References
  // ─────────────────────────────────────────────────────────────
  contractClauseRef   String? @db.VarChar(255) // Contract reference
  sourceTaskId        String? @db.Uuid // Related ProjectTask
  sourceDeliverableId String? @db.Uuid // Source deliverable
  changeOrderId       String? @db.Uuid // Related change order

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────
  tenant  Tenant        @relation("TenantToProjectMilestone", fields: [tenantId], references: [id], onDelete: Restrict)
  project Project       @relation("ProjectToMilestones", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  phase   ProjectPhase? @relation("ProjectPhaseToMilestones", fields: [tenantId, phaseId], references: [tenantId, id], onDelete: SetNull)

  // Member approval
  approvedByMember Member? @relation("ProjectMilestoneApprover", fields: [tenantId, approvedByMemberId], references: [tenantId, id], onDelete: SetNull)

  // External references
  sourceTask  ProjectTask? @relation("ProjectTaskToMilestone", fields: [tenantId, sourceTaskId], references: [tenantId, id], onDelete: SetNull)
  changeOrder ChangeOrder? @relation("ChangeOrderToMilestone", fields: [tenantId, changeOrderId], references: [tenantId, id], onDelete: SetNull)
  invoice     Invoice?     @relation("InvoiceToProjectMilestone", fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: SetNull)

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes
  // ─────────────────────────────────────────────────────────────
  @@unique([tenantId, id])
  @@unique([tenantId, projectId, milestoneCode]) // Unique code per project
  @@index([tenantId, projectId]) // Parent relationship
  @@index([tenantId, phaseId]) // Phase association
  @@index([tenantId, status]) // Status filtering
  @@index([tenantId, milestoneType]) // Type filtering
  @@index([tenantId, targetDate]) // Scheduling queries
  @@index([tenantId, actualCompletionDate]) // Completion tracking
  @@index([tenantId, isBillingMilestone]) // Billing integration
  @@index([tenantId, invoiceTriggered]) // Invoice automation
  @@index([tenantId, paymentReceived]) // Payment tracking
  @@index([tenantId, requiresClientApproval]) // Client approval
  @@index([tenantId, approvalRequired]) // Internal approval
  @@index([tenantId, inspectionRequired]) // Quality control
  @@index([tenantId, isCritical]) // Priority filtering
  @@index([tenantId, isOverdue]) // Overdue tracking
  @@index([tenantId, approvedByMemberId]) // Member tracking
  @@index([tenantId, sourceTaskId]) // Task linkage
  @@index([tenantId, deletedAt]) // Soft delete filtering
  @@index([tenantId, auditCorrelationId]) // Governance
  @@index([createdAt], type: Brin) // Temporal clustering
  @@index([metadata], type: Gin) // JSON search
  @@map("project_milestones")
}

