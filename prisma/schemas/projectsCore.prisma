  SPECIALIST // Technical specialist
  CONSULTANT // External consultant
  CONTRACTOR // Subcontractor
  INSPECTOR // Quality inspector
  SAFETY_OFFICER // Safety officer
  APPRENTICE // Apprentice
  INTERN // Intern
}

/// Skill level classification
