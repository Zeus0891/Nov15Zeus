// ============================================================================
// PROJECT ENUMS
// ============================================================================

/// Primary business workflow status
enum ProjectStatus {
  PLANNING // Planning phase, not yet started
  PENDING_APPROVAL // Submitted for approval
  APPROVED // Approved, ready to start
  ACTIVE // Work in progress
  ON_HOLD // Temporarily paused
  DELAYED // Behind schedule
  AT_RISK // At risk of failure
  COMPLETED // Work completed, awaiting closeout
  CLOSED // Project closed
  CANCELLED // Project cancelled
  DELETED // Soft deleted
}

/// Budget status dimension
enum ProjectBudgetStatus {
  ON_BUDGET // Within budget
  UNDER_BUDGET // Under budget
  APPROACHING_BUDGET // 90-100% of budget
  OVERBUDGET // Over budget
  CRITICAL // Significantly over budget (>110%)
}

/// Schedule status dimension
enum ProjectScheduleStatus {
  ON_SCHEDULE // On track
  AHEAD_OF_SCHEDULE // Ahead of schedule
  MINOR_DELAY // 1-7 days delayed
  DELAYED // >7 days delayed
  CRITICAL // Significantly delayed (>30 days)
}

/// Data classification for governance
enum ProjectDataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

/// Record source tracking for data lineage
enum ProjectRecordSource {
  API
  IMPORT
  SYSTEM
  MANUAL
  MIGRATION
}

// ============================================================================
// PROJECT PHASE ENUMS
// ============================================================================

/// Phase status lifecycle
enum PhaseStatus {
  NOT_STARTED // Phase not yet started
  IN_PROGRESS // Phase in progress
  ON_HOLD // Phase temporarily paused
  COMPLETED // Phase completed
  CANCELLED // Phase cancelled
  BLOCKED // Phase blocked by dependencies
}

/// Phase risk assessment levels
enum PhaseRiskLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  CRITICAL
}

// ============================================================================
// PROJECT MILESTONE ENUMS
// ============================================================================

/// Milestone status lifecycle
enum ProjectMilestoneStatus {
  PENDING // Milestone pending start
  IN_PROGRESS // Milestone work in progress
  COMPLETED // Milestone completed
  OVERDUE // Milestone overdue
  CANCELLED // Milestone cancelled
  ON_HOLD // Milestone on hold
}

/// Milestone type classification
enum ProjectMilestoneType {
  DELIVERABLE // Deliverable milestone
  PAYMENT // Payment milestone
  APPROVAL // Approval milestone
  INSPECTION // Inspection milestone
  PHASE_GATE // Phase gate milestone
  DECISION_POINT // Decision point
  REVIEW // Review milestone
  COMPLIANCE // Compliance checkpoint
}

/// Risk assessment levels for milestones
enum ProjectRiskLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  CRITICAL
}

// ============================================================================
// PROJECT TEAM MEMBER ENUMS
// ============================================================================

/// Team member status lifecycle
enum ProjectTeamMemberStatus {
  ACTIVE // Active team member
  INACTIVE // Temporarily inactive
  ON_LEAVE // On leave
  COMPLETED // Assignment completed
  TERMINATED // Assignment terminated
  PENDING_START // Pending start date
}

/// Team member roles in project
enum ProjectTeamRole {
  PROJECT_MANAGER // Project manager
  SUPERINTENDENT // Superintendent
  FOREMAN // Foreman
  TEAM_LEAD // Team lead
  TEAM_MEMBER // Regular team member
  SPECIALIST // Technical specialist
  CONSULTANT // External consultant
  CONTRACTOR // Subcontractor
  INSPECTOR // Quality inspector
  SAFETY_OFFICER // Safety officer
  APPRENTICE // Apprentice
  INTERN // Intern
}

/// Skill level classification
enum ProjectSkillLevel {
  BEGINNER // Entry level
  INTERMEDIATE // Intermediate level
  ADVANCED // Advanced level
  EXPERT // Expert level
  MASTER // Master craftsman
}

/// Construction trade specialties
enum ProjectTradeSpecialty {
  GENERAL // General construction
  CARPENTRY // Carpentry
  PLUMBING // Plumbing
  ELECTRICAL // Electrical
  HVAC // HVAC systems
  ROOFING // Roofing
  FLOORING // Flooring
  PAINTING // Painting
  MASONRY // Masonry
  CONCRETE // Concrete work
  STEEL // Steel work
  LANDSCAPING // Landscaping
  DEMOLITION // Demolition
  INSULATION // Insulation
  DRYWALL // Drywall
  GLAZING // Glass/glazing
  TILE // Tile work
  WELDING // Welding
  EXCAVATION // Excavation
  PAVING // Paving
}

/// Site access levels for security
enum ProjectSiteAccess {
  BASIC_ACCESS // Basic site access
  RESTRICTED // Restricted areas
  CONFIDENTIAL // Confidential areas
  FULL_ACCESS // Full site access
  ESCORT_REQUIRED // Requires escort
  NO_ACCESS // No site access
}

/// Preferred contact methods
enum ProjectContactMethod {
  EMAIL // Email communication
  PHONE // Phone calls
  SMS // Text messages
  IN_PERSON // In-person meetings
  RADIO // Radio communication
  MOBILE_APP // Mobile app notifications
}

/// Project location status lifecycle
enum ProjectLocationStatus {
  ACTIVE // Location is active and available
  INACTIVE // Location is temporarily unavailable
  UNDER_CONSTRUCTION // Location is under construction
  MAINTENANCE // Location is under maintenance
  RESTRICTED // Location access is restricted
  ARCHIVED // Location is no longer in use
}

/// Types of project locations
enum ProjectLocationType {
  JOBSITE // Primary work site
  OFFICE // Site office or field office
  WAREHOUSE // Material storage warehouse
  STAGING_AREA // Material staging area
  LAYDOWN_AREA // Equipment laydown area
  FABRICATION_SHOP // Fabrication facility
  PARKING // Parking area
  TRAILER // Temporary trailer facility
  STORAGE // General storage area
  UTILITY_AREA // Utilities and services area
  SAFETY_ZONE // Safety/first aid area
  OTHER // Other location type
}

/// Location occupancy status
enum ProjectLocationOccupancy {
  VACANT // No current occupants
  PARTIAL // Partially occupied
  FULL // Fully occupied
  OVEROCCUPIED // Over capacity
  RESERVED // Reserved for future use
  RESTRICTED // Occupancy restricted
}

/// Security levels for project locations
enum ProjectLocationSecurity {
  PUBLIC // Public access allowed
  STANDARD // Standard security measures
  ENHANCED // Enhanced security required
  HIGH // High security clearance needed
  MAXIMUM // Maximum security protocols
  CLASSIFIED // Classified/confidential area
}

/// Weather exposure levels
enum ProjectWeatherExposure {
  MINIMAL // Fully enclosed/protected
  LOW // Mostly protected
  MODERATE // Some weather exposure
  HIGH // Significant weather exposure
  EXTREME // Full weather exposure
  HAZARDOUS // Weather creates safety hazards
}
