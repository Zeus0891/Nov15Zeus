model Project {
  // 🆔 Identity, Tenant and Global (BH Pattern - Base Hybrid)
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  globalId String @db.Uuid // 1:1:1 traceability with Estimate/Invoice

  // 📊 Lifecycle
  status    ProjectStatus @default(PLANNING)
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?     @db.Timestamptz(6)

  // 👤 Actor Attribution (Pattern B - Full Relations for Critical Entity)
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // 🧠 Governance
  auditCorrelationId String?                   @db.Uuid
  dataClassification ProjectDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  metadata           Json?                     @db.JsonB
  recordSource       ProjectRecordSource?
  timezone           String?                   @db.VarChar(50)

  // 📄 Business Identity
  projectNumber String  @db.VarChar(50) // EST-2025-00123 (inherited from Estimate)
  projectName   String  @db.VarChar(255) // Human-readable name
  projectCode   String? @db.VarChar(50) // Internal project code
  title         String  @db.VarChar(500) // Full project title
  description   String? @db.Text // Project description
  scope         String? @db.Text // Scope of work

  // 📊 Triple Status Dimension
  budgetStatus   ProjectBudgetStatus   @default(ON_BUDGET)
  scheduleStatus ProjectScheduleStatus @default(ON_SCHEDULE)

  // 🔗 Source Linkage (1:1:1 Traceability)
  sourceEstimateId String? @db.Uuid
  contractId       String? @db.Uuid

  // 👥 CRM Linkage (Future Enhancement)
  jobsiteAddressId String? @db.Uuid

  // 📅 Dates & Timeline
  // Planned dates
  plannedStartDate DateTime? @db.Timestamptz(6)
  plannedEndDate   DateTime? @db.Timestamptz(6)
  plannedDuration  Int? // Days

  // Baseline dates (original plan)
  baselineStartDate DateTime? @db.Timestamptz(6)
  baselineEndDate   DateTime? @db.Timestamptz(6)
  baselineDuration  Int?

  // Actual dates
  actualStartDate DateTime? @db.Timestamptz(6)
  actualEndDate   DateTime? @db.Timestamptz(6)
  actualDuration  Int?

  // Forecast dates (projected)
  forecastEndDate  DateTime? @db.Timestamptz(6)
  forecastDuration Int?

  // 💰 Financial Totals (Denormalized for Performance)
  currencyCode String @default("USD") @db.Char(3) // ISO 4217 (USD, EUR, CAD)

  // Budget amounts
  budgetedLaborCost       Decimal @default(0) @db.Decimal(12, 2)
  budgetedMaterialCost    Decimal @default(0) @db.Decimal(12, 2)
  budgetedEquipmentCost   Decimal @default(0) @db.Decimal(12, 2)
  budgetedSubcontractCost Decimal @default(0) @db.Decimal(12, 2)
  budgetedOtherCost       Decimal @default(0) @db.Decimal(12, 2)
  totalBudgetedCost       Decimal @default(0) @db.Decimal(12, 2)

  // Actual costs (from time tracking, purchases, etc.)
  actualLaborCost       Decimal @default(0) @db.Decimal(12, 2)
  actualMaterialCost    Decimal @default(0) @db.Decimal(12, 2)
  actualEquipmentCost   Decimal @default(0) @db.Decimal(12, 2)
  actualSubcontractCost Decimal @default(0) @db.Decimal(12, 2)
  actualOtherCost       Decimal @default(0) @db.Decimal(12, 2)
  totalActualCost       Decimal @default(0) @db.Decimal(12, 2)

  // Committed costs (POs not yet received/invoiced)
  committedCost Decimal @default(0) @db.Decimal(12, 2)

  // Variance analysis
  costVariance           Decimal @default(0) @db.Decimal(12, 2) // budget - actual
  costVariancePercentage Decimal @default(0) @db.Decimal(5, 2) // (variance / budget) * 100

  // Revenue & profitability
  contractValue         Decimal @default(0) @db.Decimal(12, 2)
  billedToDate          Decimal @default(0) @db.Decimal(12, 2)
  unbilledAmount        Decimal @default(0) @db.Decimal(12, 2)
  grossProfit           Decimal @default(0) @db.Decimal(12, 2)
  grossMarginPercentage Decimal @default(0) @db.Decimal(5, 2)

  // 📊 Progress Tracking
  // Overall project completion
  percentComplete Decimal @default(0) @db.Decimal(5, 2) // 0-100%
  percentBilled   Decimal @default(0) @db.Decimal(5, 2)
  percentPaid     Decimal @default(0) @db.Decimal(5, 2)

  // Task counts
  totalTaskCount      Int @default(0)
  completedTaskCount  Int @default(0)
  inProgressTaskCount Int @default(0)
  notStartedTaskCount Int @default(0)

  // Milestone tracking
  totalMilestoneCount     Int @default(0)
  completedMilestoneCount Int @default(0)

  // 👥 Team & Resources
  // Project manager
  projectManagerMemberId String? @db.Uuid
  // Superintendent/foreman
  superintendentMemberId String? @db.Uuid
  // Team size
  teamMemberCount        Int     @default(0)

  // ⚙️ Behavior Flags
  isTemplate        Boolean @default(false) // Reusable project template
  isArchived        Boolean @default(false) // Archive flag (soft)
  isBillable        Boolean @default(true) // Billable to client
  allowTimeTracking Boolean @default(true) // Enable time tracking
  allowExpenses     Boolean @default(true) // Allow expense tracking
  requireApproval   Boolean @default(false) // Approval required for changes
  isInternal        Boolean @default(false) // Internal project (non-billable)

  // 📅 Event Timestamps
  kickoffDate            DateTime? @db.Timestamptz(6) // Project kickoff meeting
  submittedForApprovalAt DateTime? @db.Timestamptz(6)
  approvedAt             DateTime? @db.Timestamptz(6)
  startedAt              DateTime? @db.Timestamptz(6) // Actual work start
  completedAt            DateTime? @db.Timestamptz(6) // Work completed
  closedAt               DateTime? @db.Timestamptz(6) // Project closed

  // 🔗 External Module Integration
  approvalRequestId          String? @db.Uuid
  numberSequenceAllocationId String? @db.Uuid

  // 🔗 Relations
  tenant Tenant @relation("TenantToProject", fields: [tenantId], references: [id], onDelete: Restrict)

  // 👤 Actor Relations (Pattern B - Full Relations for Critical Parent Entity)
  createdByActor Actor? @relation("ProjectCreatedByActor", fields: [createdByActorId], references: [id], onDelete: SetNull)
  updatedByActor Actor? @relation("ProjectUpdatedByActor", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  deletedByActor Actor? @relation("ProjectDeletedByActor", fields: [deletedByActorId], references: [id], onDelete: SetNull)

  // 🔗 Source Relations (1:1:1 Traceability)
  sourceEstimate Estimate? @relation("EstimateToProjects", fields: [tenantId, sourceEstimateId], references: [tenantId, id], onDelete: SetNull)

  // 🔗 CRM Relations (Future Enhancement)
  jobsiteAddress CRMAddress? @relation("ProjectJobsiteAddress", fields: [tenantId, jobsiteAddressId], references: [tenantId, id], onDelete: SetNull)

  // 🔗 Team Relations
  projectManager Member? @relation("ProjectManager", fields: [tenantId, projectManagerMemberId], references: [tenantId, id], onDelete: SetNull)
  superintendent Member? @relation("ProjectSuperintendent", fields: [tenantId, superintendentMemberId], references: [tenantId, id], onDelete: SetNull)

  // 🔗 External Module Relations
  approvalRequest ApprovalRequest? @relation("ProjectApprovalRequest", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: SetNull)
  contract        Contract?        @relation("ProjectContract", fields: [tenantId, contractId], references: [tenantId, id], onDelete: SetNull)

  // 🔗 Child Relations (1:M)
  phases        ProjectPhase[]        @relation("ProjectToPhases")
  milestones    ProjectMilestone[]    @relation("ProjectToMilestones")
  teamMembers   ProjectTeamMember[]   @relation("ProjectToTeamMembers")
  locations     ProjectLocation[]     @relation("ProjectToLocations")
  budgets       ProjectBudget[]
  documents     ProjectDocument[]
  attachments   ProjectAttachment[]
  historyEvents ProjectHistoryEvent[]

  // 🔗 Cross-Module Back Relations (via globalId)
  invoices Invoice[] @relation("ProjectToInvoices")

  // 🗂️ Constraints & Strategic Indexes (41 indexes per architecture)
  // Primary constraints
  @@unique([tenantId, id])
  @@unique([tenantId, globalId]) // Hybrid pattern constraint
  @@unique([tenantId, projectNumber]) // Business key uniqueness
  // Global linkage (cross-tenant lookup for 1:1:1 traceability)
  @@index([globalId])
  // Triple status filters (most common queries)
  @@index([tenantId, status])
  @@index([tenantId, budgetStatus])
  @@index([tenantId, scheduleStatus])
  // Common filters (list view filtering)
  @@index([tenantId, projectManagerMemberId])
  @@index([tenantId, superintendentMemberId])
  @@index([tenantId, sourceEstimateId])
  @@index([tenantId, contractId])
  @@index([tenantId, deletedAt]) // Soft delete filtering
  // Time-based queries (BRIN for temporal clustering)
  @@index([plannedStartDate], type: Brin)
  @@index([plannedEndDate], type: Brin)
  @@index([actualStartDate], type: Brin)
  @@index([createdAt], type: Brin)
  // Financial queries
  @@index([tenantId, totalBudgetedCost])
  @@index([tenantId, totalActualCost])
  @@index([tenantId, costVariance])
  @@index([tenantId, grossMarginPercentage])
  // Progress & completion
  @@index([tenantId, percentComplete])
  @@index([tenantId, completedAt])
  @@index([tenantId, closedAt])
  // Analytics & governance
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  // CRM lookups
  @@index([tenantId, jobsiteAddressId])
  // External modules
  @@index([tenantId, approvalRequestId])
  @@index([tenantId, numberSequenceAllocationId])
  // Behavior flags
  @@index([tenantId, isTemplate])
  @@index([tenantId, isArchived])
  @@index([tenantId, isBillable])
  @@index([tenantId, isInternal])
  @@index([tenantId, allowTimeTracking])
  // Event timestamps
  @@index([tenantId, startedAt])
  @@index([tenantId, kickoffDate])
  @@index([tenantId, approvedAt])
  // Governance & extensibility
  @@index([tenantId, timezone])
  @@index([metadata], type: Gin)
  @@map("projects")
}

model ProjectPhase {
  // ─────────────────────────────────────────────────────────────
  // 🆔 Identity & Tenant (Pattern A - Child Entity)
  // ─────────────────────────────────────────────────────────────
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📊 Lifecycle & Concurrency
  // ─────────────────────────────────────────────────────────────
  status    PhaseStatus @default(NOT_STARTED)
  version   Int         @default(1)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?   @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 👤 Actor Attribution (Pattern A - IDs only for Child Entity)
  // ─────────────────────────────────────────────────────────────
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 🔍 Enterprise Governance
  // ─────────────────────────────────────────────────────────────
  auditCorrelationId String?                   @db.Uuid
  dataClassification ProjectDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       ProjectRecordSource?
  metadata           Json?                     @db.JsonB
  timezone           String?                   @db.VarChar(50)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Parent Relationship (Required)
  // ─────────────────────────────────────────────────────────────
  projectId String @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 🔗 Source Linkage (1:1:1 Traceability)
  // ─────────────────────────────────────────────────────────────
  sourceEstimateSectionId String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📄 Phase Identity & Organization
  // ─────────────────────────────────────────────────────────────
  phaseNumber Int     @db.Integer // Sequence order (1, 2, 3...)
  phaseName   String  @db.VarChar(255)
  phaseCode   String  @db.VarChar(50) // Internal phase code (PH-001, PH-002)
  description String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 📊 Phase Organization & Display
  // ─────────────────────────────────────────────────────────────
  displayOrder Int     @default(0) @db.Integer // UI display order
  phaseGroup   String? @db.VarChar(100) // Grouping phases (e.g., "Foundation", "Structure")
  colorCode    String? @db.VarChar(7) // Hex color for visual representation
  iconName     String? @db.VarChar(50) // Icon identifier for UI

  // ─────────────────────────────────────────────────────────────
  // 📅 Phase Timeline & Scheduling
  // ─────────────────────────────────────────────────────────────
  plannedStartDate DateTime? @db.Timestamptz(6)
  plannedEndDate   DateTime? @db.Timestamptz(6)
  plannedDuration  Int?      @db.Integer // Days

  baselineStartDate DateTime? @db.Timestamptz(6)
  baselineEndDate   DateTime? @db.Timestamptz(6)
  baselineDuration  Int?      @db.Integer

  actualStartDate DateTime? @db.Timestamptz(6)
  actualEndDate   DateTime? @db.Timestamptz(6)
  actualDuration  Int?      @db.Integer

  forecastEndDate DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 💰 Phase Financial Management
  // ─────────────────────────────────────────────────────────────
  budgetedAmount      Decimal @default(0) @db.Decimal(12, 2)
  actualCost          Decimal @default(0) @db.Decimal(12, 2)
  committedCost       Decimal @default(0) @db.Decimal(12, 2)
  costVariance        Decimal @default(0) @db.Decimal(12, 2) // budget - (actual + committed)
  costVariancePercent Decimal @default(0) @db.Decimal(8, 4)

  // Financial breakdown
  budgetedLaborCost     Decimal @default(0) @db.Decimal(12, 2)
  budgetedMaterialCost  Decimal @default(0) @db.Decimal(12, 2)
  budgetedEquipmentCost Decimal @default(0) @db.Decimal(12, 2)
  budgetedOtherCost     Decimal @default(0) @db.Decimal(12, 2)

  actualLaborCost     Decimal @default(0) @db.Decimal(12, 2)
  actualMaterialCost  Decimal @default(0) @db.Decimal(12, 2)
  actualEquipmentCost Decimal @default(0) @db.Decimal(12, 2)
  actualOtherCost     Decimal @default(0) @db.Decimal(12, 2)

  // ─────────────────────────────────────────────────────────────
  // 📊 Progress Tracking & Performance
  // ─────────────────────────────────────────────────────────────
  percentComplete   Decimal @default(0) @db.Decimal(8, 4) // 0-100%
  weighedPercentage Decimal @default(0) @db.Decimal(8, 4) // Weight in overall project
  earnedValue       Decimal @default(0) @db.Decimal(12, 2)
  plannedValue      Decimal @default(0) @db.Decimal(12, 2)

  // Task tracking
  totalTaskCount      Int @default(0) @db.Integer
  completedTaskCount  Int @default(0) @db.Integer
  inProgressTaskCount Int @default(0) @db.Integer
  notStartedTaskCount Int @default(0) @db.Integer

  // Milestone tracking
  milestoneCount      Int @default(0) @db.Integer
  completedMilestones Int @default(0) @db.Integer

  // ─────────────────────────────────────────────────────────────
  // ⚙️ Phase Configuration & Rules
  // ─────────────────────────────────────────────────────────────
  isCriticalPath   Boolean @default(false)
  isOptional       Boolean @default(false)
  canStartEarly    Boolean @default(false)
  requiresApproval Boolean @default(false)
  isTemplate       Boolean @default(false)

  // Dependencies
  hasDependencies   Boolean @default(false)
  dependsOnPhaseIds Json?   @db.JsonB // Array of phase IDs this depends on
  blocksPhaseIds    Json?   @db.JsonB // Array of phase IDs this blocks

  // ─────────────────────────────────────────────────────────────
  // 📋 Quality & Compliance
  // ─────────────────────────────────────────────────────────────
  qualityScore           Decimal?  @db.Decimal(5, 2) // 0-100 quality score
  complianceRequirements Json?     @db.JsonB // Array of compliance requirements
  inspectionRequired     Boolean   @default(false)
  inspectionPassed       Boolean   @default(false)
  inspectionDate         DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // ⚠️ Risk & Issue Management
  // ─────────────────────────────────────────────────────────────
  riskLevel        PhaseRiskLevel @default(LOW)
  activeRiskCount  Int            @default(0) @db.Integer
  activeIssueCount Int            @default(0) @db.Integer
  blockerCount     Int            @default(0) @db.Integer

  // ─────────────────────────────────────────────────────────────
  // 📝 Documentation & Notes
  // ─────────────────────────────────────────────────────────────
  phaseObjectives String? @db.Text
  deliverables    Json?   @db.JsonB // Array of expected deliverables
  assumptions     String? @db.Text
  constraints     String? @db.Text
  successCriteria String? @db.Text
  lessonsLearned  String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 👥 Phase Team & Resources
  // ─────────────────────────────────────────────────────────────
  phaseManagerId       String? @db.Uuid // Member responsible for this phase
  teamMemberCount      Int     @default(0) @db.Integer
  requiredSkills       Json?   @db.JsonB // Array of required skills
  resourceRequirements Json?   @db.JsonB // Equipment, materials, etc.

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────
  tenant  Tenant  @relation("TenantToProjectPhase", fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation("ProjectToPhases", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  // Source traceability
  sourceEstimateSection EstimateSection? @relation("EstimateSectionToProjectPhase", fields: [tenantId, sourceEstimateSectionId], references: [tenantId, id], onDelete: SetNull)

  // Phase manager
  phaseManager Member? @relation("ProjectPhaseManager", fields: [tenantId, phaseManagerId], references: [tenantId, id], onDelete: SetNull)

  // Child relations (1:M)
  tasks       ProjectTask[]       @relation("ProjectPhaseToTasks")
  milestones  ProjectMilestone[]  @relation("ProjectPhaseToMilestones")
  teamMembers ProjectTeamMember[] @relation("ProjectPhaseToTeamMembers")

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes (30+ indexes per architecture)
  // ─────────────────────────────────────────────────────────────
  @@unique([tenantId, id])
  @@unique([tenantId, projectId, phaseNumber]) // Unique phase number per project
  @@unique([tenantId, projectId, phaseCode]) // Unique phase code per project
  // Parent relationship
  @@index([tenantId, projectId]) // Most common lookup
  // Status & lifecycle
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  // Source traceability
  @@index([tenantId, sourceEstimateSectionId])
  // Scheduling & timeline
  @@index([tenantId, plannedStartDate])
  @@index([tenantId, plannedEndDate])
  @@index([tenantId, actualStartDate])
  @@index([tenantId, displayOrder])
  // Financial tracking
  @@index([tenantId, budgetedAmount])
  @@index([tenantId, actualCost])
  @@index([tenantId, costVariance])
  // Progress & performance
  @@index([tenantId, percentComplete])
  @@index([tenantId, earnedValue])
  // Critical path & dependencies
  @@index([tenantId, isCriticalPath])
  @@index([tenantId, hasDependencies])
  // Quality & compliance
  @@index([tenantId, inspectionRequired])
  @@index([tenantId, inspectionPassed])
  @@index([tenantId, qualityScore])
  // Risk management
  @@index([tenantId, riskLevel])
  @@index([tenantId, activeRiskCount])
  @@index([tenantId, activeIssueCount])
  // Team & resources
  @@index([tenantId, phaseManagerId])
  @@index([tenantId, teamMemberCount])
  // Configuration flags
  @@index([tenantId, isOptional])
  @@index([tenantId, requiresApproval])
  @@index([tenantId, isTemplate])
  // Temporal queries (BRIN for performance)
  @@index([createdAt], type: Brin)
  @@index([plannedStartDate], type: Brin)
  @@index([actualStartDate], type: Brin)
  // Governance & analytics
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  @@index([tenantId, timezone])
  // JSON metadata search
  @@index([metadata], type: Gin)
  @@index([deliverables], type: Gin)
  @@index([dependsOnPhaseIds], type: Gin)
  @@index([complianceRequirements], type: Gin)
  @@map("project_phases")
}

model ProjectMilestone {
  // ─────────────────────────────────────────────────────────────
  // 🆔 Primary Key & Identity
  // ─────────────────────────────────────────────────────────────
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📊 Lifecycle & Concurrency
  // ─────────────────────────────────────────────────────────────
  status    ProjectMilestoneStatus @default(PENDING)
  version   Int                    @default(1)
  createdAt DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?              @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 👤 Actor Attribution (Pattern A - IDs only for child entities)
  // ─────────────────────────────────────────────────────────────
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 🔍 Enterprise Governance
  // ─────────────────────────────────────────────────────────────
  auditCorrelationId String?                   @db.Uuid
  dataClassification ProjectDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       ProjectRecordSource?
  metadata           Json?                     @db.JsonB

  // ─────────────────────────────────────────────────────────────
  // 🔗 Parent Relationship (Required)
  // ─────────────────────────────────────────────────────────────
  projectId String  @db.Uuid
  phaseId   String? @db.Uuid // Optional phase association

  // ─────────────────────────────────────────────────────────────
  // 📋 Milestone Identity & Classification
  // ─────────────────────────────────────────────────────────────
  milestoneName        String               @db.VarChar(255)
  milestoneDescription String?              @db.Text
  milestoneType        ProjectMilestoneType @default(DELIVERABLE)
  milestoneCode        String?              @db.VarChar(50)
  sequenceOrder        Int                  @default(1)

  // ─────────────────────────────────────────────────────────────
  // 📅 Milestone Scheduling
  // ─────────────────────────────────────────────────────────────
  targetDate           DateTime  @db.Timestamptz(6)
  baselineDate         DateTime? @db.Timestamptz(6) // Original target
  actualStartDate      DateTime? @db.Timestamptz(6)
  actualCompletionDate DateTime? @db.Timestamptz(6)

  // Duration tracking
  plannedDuration Int? // Days to complete
  actualDuration  Int? // Actual days taken

  // Schedule variance
  scheduleVariance Int     @default(0) // Days ahead/behind
  isOnSchedule     Boolean @default(true)
  isOverdue        Boolean @default(false)

  // ─────────────────────────────────────────────────────────────
  // 💰 Financial & Payment Integration
  // ─────────────────────────────────────────────────────────────
  isBillingMilestone Boolean @default(false)
  billingAmount      Decimal @default(0) @db.Decimal(12, 2)
  billingPercentage  Decimal @default(0) @db.Decimal(5, 2) // % of total project
  paymentTerms       String? @db.VarChar(255)

  // Invoice integration
  invoiceTriggered Boolean   @default(false)
  invoiceCreatedAt DateTime? @db.Timestamptz(6)
  invoiceId        String?   @db.Uuid // Link to generated invoice

  // Payment tracking
  paymentReceived   Boolean   @default(false)
  paymentReceivedAt DateTime? @db.Timestamptz(6)
  paymentAmount     Decimal   @default(0) @db.Decimal(12, 2)

  // ─────────────────────────────────────────────────────────────
  // 📊 Progress & Completion Tracking
  // ─────────────────────────────────────────────────────────────
  percentComplete Decimal @default(0) @db.Decimal(5, 2) // 0-100%
  weightInProject Decimal @default(0) @db.Decimal(5, 2) // Importance weight

  // Completion criteria
  completionCriteria String? @db.Text
  acceptanceCriteria String? @db.Text
  deliverables       Json?   @db.JsonB // Required deliverables

  // Quality gates
  qualityCheckRequired Boolean  @default(false)
  qualityCheckPassed   Boolean  @default(false)
  qualityScore         Decimal? @db.Decimal(5, 2)

  // ─────────────────────────────────────────────────────────────
  // ✅ Verification & Approval
  // ─────────────────────────────────────────────────────────────
  verificationRequired Boolean   @default(true)
  verifiedAt           DateTime? @db.Timestamptz(6)
  verifiedByActorId    String?   @db.Uuid
  verificationNotes    String?   @db.Text

  // Client approval
  requiresClientApproval Boolean   @default(false)
  clientApproved         Boolean   @default(false)
  clientApprovedAt       DateTime? @db.Timestamptz(6)
  clientApprovalNotes    String?   @db.Text

  // Internal approval
  approvalRequired   Boolean   @default(false)
  approvedAt         DateTime? @db.Timestamptz(6)
  approvedByMemberId String?   @db.Uuid
  approvalNotes      String?   @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🏗️ Construction-Specific Features
  // ─────────────────────────────────────────────────────────────
  inspectionRequired Boolean   @default(false)
  inspectionPassed   Boolean   @default(false)
  inspectionDate     DateTime? @db.Timestamptz(6)
  inspectorName      String?   @db.VarChar(200)
  inspectionNotes    String?   @db.Text

  // Permit and compliance
  permitsRequired    Json?   @db.JsonB // Required permits
  complianceVerified Boolean @default(false)
