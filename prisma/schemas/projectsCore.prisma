  @@index([tenantId, occupancyStatus])
  @@index([tenantId, maxOccupancy])
  @@index([tenantId, currentOccupancy])
  // Access & security
  @@index([tenantId, accessLevel])
  @@index([tenantId, securityLevel])
  @@index([tenantId, keyHolder])
  // Safety & environment
  @@index([tenantId, weatherExposure])
  @@index([tenantId, safetyIncidents])
  @@index([tenantId, qualityIssues])
  // Utilities & infrastructure
  @@index([tenantId, electricalCapacity])
  @@index([tenantId, internetAvailable])
  @@index([tenantId, parkingSpaces])
  @@index([tenantId, hasLoadingDock])
  // Schedule & availability
  @@index([tenantId, availableFrom])
  @@index([tenantId, availableUntil])
  @@index([tenantId, weekendWorkAllowed])
  @@index([tenantId, holidayWorkAllowed])
  // Financial
  @@index([tenantId, monthlyRent])
  @@index([tenantId, costCenter])
  @@index([tenantId, currencyCode])
  // Contacts & management
  @@index([tenantId, propertyManager])
  // Performance tracking
  @@index([tenantId, totalHoursWorked])
  @@index([tenantId, activeTeamMembers])
  @@index([tenantId, lastInspectionAt])
  @@index([tenantId, nextInspectionDue])
  // Temporal queries (BRIN for performance)
  @@index([createdAt], type: Brin)
  @@index([availableFrom], type: Brin)
  @@index([nextInspectionDue], type: Brin)
  // Governance & analytics
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  @@index([tenantId, timezone])
  // JSON metadata searches
  @@index([metadata], type: Gin)
  @@index([availableUtilities], type: Gin)
  @@index([workZones], type: Gin)
  @@index([safetyHazards], type: Gin)
  @@index([requiredPermits], type: Gin)
  @@map("project_locations")
}

