  /// Full street address
  streetAddress String? @db.VarChar(500)

  /// Apartment, suite, unit number
  addressLine2 String? @db.VarChar(200)

  /// City name
  city String? @db.VarChar(100)

  /// State, province, or region
  stateProvince String? @db.VarChar(100)

  /// Postal or ZIP code
  postalCode String? @db.VarChar(20)

  /// Country name or code
  country String? @db.VarChar(100)

  /// Latitude coordinate (GPS)
  latitude Decimal? @db.Decimal(10, 8)

  /// Longitude coordinate (GPS)
  longitude Decimal? @db.Decimal(11, 8)

  /// Elevation above sea level (in meters)
  elevation Decimal? @db.Decimal(8, 2)

  /// Geographic accuracy level
  gpsAccuracy Decimal? @db.Decimal(6, 2) // meters

  /// Timezone for this location
  locationTimezone String? @db.VarChar(50)

  // ─────────────────────────────────────────────────────────────
  // 🏢 Site Information & Characteristics
  // ─────────────────────────────────────────────────────────────

  /// Site size in square meters
  siteArea Decimal? @db.Decimal(12, 2)

  /// Building footprint area
  buildingArea Decimal? @db.Decimal(12, 2)

  /// Number of floors/levels
  floorCount Int? @db.Integer

  /// Building height in meters
  buildingHeight Decimal? @db.Decimal(8, 2)

  /// Year built or construction year
  yearBuilt Int? @db.Integer

  /// Current occupancy status
  occupancyStatus ProjectLocationOccupancy @default(VACANT)

  /// Maximum occupancy capacity
  maxOccupancy Int? @db.Integer

  /// Current occupancy count
  currentOccupancy Int @default(0) @db.Integer

  // ─────────────────────────────────────────────────────────────
  // 🔐 Access Control & Security
  // ─────────────────────────────────────────────────────────────

  /// Site access level requirements
  accessLevel ProjectSiteAccess @default(BASIC_ACCESS)

  /// Security requirements
  securityLevel ProjectLocationSecurity @default(STANDARD)

  /// Access hours (JSON format: {open: "08:00", close: "17:00"})
  accessHours Json? @db.JsonB

  /// Key holder or site contact information
  keyHolder String? @db.VarChar(200)

  /// Access instructions
  accessInstructions String? @db.Text

  /// Security contact information
  securityContact String? @db.VarChar(200)

  /// Emergency contact information
  emergencyContact String? @db.VarChar(500)

  /// Gate codes, lock combinations, etc. (encrypted)
  accessCodes String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🚧 Safety & Environmental Information
  // ─────────────────────────────────────────────────────────────

  /// Safety hazards present at location
  safetyHazards Json? @db.JsonB // Array of hazard types

  /// Environmental conditions
  environmentalConditions String? @db.Text

  /// Required PPE for site
  requiredPPE Json? @db.JsonB // Array of PPE requirements

  /// Soil conditions
  soilConditions String? @db.VarChar(200)

  /// Weather exposure level
  weatherExposure ProjectWeatherExposure @default(MODERATE)

  /// Flood zone designation
  floodZone String? @db.VarChar(50)

  /// Seismic zone rating
  seismicZone String? @db.VarChar(50)

  // ─────────────────────────────────────────────────────────────
  // 🔌 Utilities & Infrastructure
  // ─────────────────────────────────────────────────────────────

  /// Available utilities (JSON array)
  availableUtilities Json? @db.JsonB // [ELECTRIC, WATER, GAS, SEWER, etc.]

  /// Electrical service capacity (amps)
  electricalCapacity Int? @db.Integer

  /// Water pressure (PSI)
  waterPressure Decimal? @db.Decimal(6, 2)

  /// Gas meter location/type
  gasMeterInfo String? @db.VarChar(200)

  /// Internet/telecom availability
  internetAvailable Boolean @default(false)

  /// Cellular signal strength (1-5 bars)
  cellularSignal Int? @db.Integer

  /// Parking availability
  parkingSpaces Int? @db.Integer

  /// Loading dock availability
  hasLoadingDock Boolean @default(false)

  /// Storage areas available
  storageAreas Json? @db.JsonB

  // ─────────────────────────────────────────────────────────────
  // 🏗️ Construction & Work Areas
  // ─────────────────────────────────────────────────────────────

  /// Work zones within location
  workZones Json? @db.JsonB // Array of zone definitions

  /// Material staging areas
  stagingAreas Json? @db.JsonB

  /// Equipment laydown areas
  laydownAreas Json? @db.JsonB

  /// Waste disposal locations
  wasteDisposalArea String? @db.VarChar(200)

  /// Temporary facilities location
  temporaryFacilities String? @db.Text

  /// Site office location
  siteOfficeLocation String? @db.VarChar(200)

  /// Tool storage locations
  toolStorage Json? @db.JsonB

  // ─────────────────────────────────────────────────────────────
  // 📋 Permits & Compliance
  // ─────────────────────────────────────────────────────────────

  /// Required permits for work
  requiredPermits Json? @db.JsonB // Array of permit types

  /// Permit numbers and status
  permitStatus Json? @db.JsonB

  /// Zoning restrictions
  zoningRestrictions String? @db.Text

  /// Building code requirements
  buildingCodeRequirements String? @db.Text

  /// Historic designation or restrictions
  historicDesignation String? @db.VarChar(200)

  /// HOA or community restrictions
  communityRestrictions String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // ⏰ Schedule & Availability
  // ─────────────────────────────────────────────────────────────

  /// Location available from date
  availableFrom DateTime? @db.Timestamptz(6)

  /// Location available until date
  availableUntil DateTime? @db.Timestamptz(6)

  /// Working hours (JSON format)
  workingHours Json? @db.JsonB

  /// Restricted hours or blackout periods
  restrictedHours Json? @db.JsonB

  /// Weekend work allowed
  weekendWorkAllowed Boolean @default(true)

  /// Holiday work allowed
  holidayWorkAllowed Boolean @default(false)

  /// Noise restrictions (hours when noise work is prohibited)
  noiseRestrictions Json? @db.JsonB

  // ─────────────────────────────────────────────────────────────
  // 💰 Cost & Financial Information
  // ─────────────────────────────────────────────────────────────

  /// Monthly rental cost for location
  monthlyRent Decimal? @db.Decimal(10, 2)

  /// Security deposit required
  securityDeposit Decimal? @db.Decimal(10, 2)

  /// Utility costs (monthly average)
  utilityCosts Decimal? @db.Decimal(8, 2)

  /// Insurance requirements/costs
  insuranceCosts Decimal? @db.Decimal(8, 2)

  /// Currency for financial fields
  currencyCode String @default("USD") @db.Char(3)

  /// Cost center for location expenses
  costCenter String? @db.VarChar(100)

  // ─────────────────────────────────────────────────────────────
  // 📞 Contact Information
  // ─────────────────────────────────────────────────────────────

  /// Property manager name
  propertyManager String? @db.VarChar(200)

  /// Property manager contact
  propertyManagerContact String? @db.VarChar(500)

  /// Property owner information
  propertyOwner String? @db.VarChar(200)

  /// Local authority contacts (building dept, etc.)
  localAuthorityContacts Json? @db.JsonB

  /// Neighbor contacts (for notifications)
  neighborContacts Json? @db.JsonB

  /// Vendor contacts (utilities, services)
  vendorContacts Json? @db.JsonB

  // ─────────────────────────────────────────────────────────────
  // 📊 Performance & Analytics
  // ─────────────────────────────────────────────────────────────

  /// Total hours worked at location
  totalHoursWorked Decimal @default(0) @db.Decimal(10, 2)

  /// Number of active team members
  activeTeamMembers Int @default(0) @db.Integer

  /// Safety incident count
  safetyIncidents Int @default(0) @db.Integer

  /// Quality issues count
  qualityIssues Int @default(0) @db.Integer

  /// Weather delays count
  weatherDelays Int @default(0) @db.Integer

  /// Access issues count
  accessIssues Int @default(0) @db.Integer

  /// Last inspection date
  lastInspectionAt DateTime? @db.Timestamptz(6)

  /// Next inspection due date
  nextInspectionDue DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────

  tenant  Tenant  @relation("TenantToProjectLocation", fields: [tenantId], references: [id], onDelete: Restrict)
  project Project @relation("ProjectToLocations", fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  // Child relations - team members and tasks assigned to this location
  teamMembers ProjectTeamMember[] @relation("ProjectLocationTeamMembers")
  tasks       ProjectTask[]       @relation("ProjectLocationTasks")

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes (35+ indexes for comprehensive access)
  // ─────────────────────────────────────────────────────────────

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, locationCode]) // Unique location codes per project
  // Parent relationships
  @@index([tenantId, projectId]) // Most common lookup
  // Status & lifecycle
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  // Location identification
  @@index([tenantId, locationType])
  @@index([tenantId, locationName])
  @@index([tenantId, displayOrder])
  // Geographic queries
  @@index([tenantId, city])
  @@index([tenantId, stateProvince])
  @@index([tenantId, country])
  @@index([tenantId, postalCode])
  @@index([latitude, longitude]) // Geospatial queries
  @@index([tenantId, locationTimezone])
  // Site characteristics
  @@index([tenantId, siteArea])
  @@index([tenantId, occupancyStatus])
  @@index([tenantId, maxOccupancy])
  @@index([tenantId, currentOccupancy])
  // Access & security
  @@index([tenantId, accessLevel])
  @@index([tenantId, securityLevel])
  @@index([tenantId, keyHolder])
  // Safety & environment
  @@index([tenantId, weatherExposure])
  @@index([tenantId, safetyIncidents])
  @@index([tenantId, qualityIssues])
  // Utilities & infrastructure
  @@index([tenantId, electricalCapacity])
  @@index([tenantId, internetAvailable])
  @@index([tenantId, parkingSpaces])
  @@index([tenantId, hasLoadingDock])
  // Schedule & availability
  @@index([tenantId, availableFrom])
  @@index([tenantId, availableUntil])
  @@index([tenantId, weekendWorkAllowed])
  @@index([tenantId, holidayWorkAllowed])
  // Financial
  @@index([tenantId, monthlyRent])
  @@index([tenantId, costCenter])
  @@index([tenantId, currencyCode])
  // Contacts & management
  @@index([tenantId, propertyManager])
  // Performance tracking
  @@index([tenantId, totalHoursWorked])
  @@index([tenantId, activeTeamMembers])
  @@index([tenantId, lastInspectionAt])
  @@index([tenantId, nextInspectionDue])
  // Temporal queries (BRIN for performance)
  @@index([createdAt], type: Brin)
  @@index([availableFrom], type: Brin)
  @@index([nextInspectionDue], type: Brin)
  // Governance & analytics
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  @@index([tenantId, timezone])
  // JSON metadata searches
  @@index([metadata], type: Gin)
  @@index([availableUtilities], type: Gin)
  @@index([workZones], type: Gin)
  @@index([safetyHazards], type: Gin)
  @@index([requiredPermits], type: Gin)
  @@map("project_locations")
}

