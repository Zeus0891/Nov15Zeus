  timezone           String?                   @db.VarChar(50)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Parent Relationship (Required)
  // ─────────────────────────────────────────────────────────────
  projectId String @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📋 Budget Identity & Classification
  // ─────────────────────────────────────────────────────────────
  budgetName        String            @db.VarChar(255)
  budgetCode        String?           @db.VarChar(50)
  budgetType        ProjectBudgetType @default(ORIGINAL)
  budgetDescription String?           @db.Text
  displayOrder      Int               @default(0)

  // ─────────────────────────────────────────────────────────────
  // 📅 Budget Timeline & Lifecycle
  // ─────────────────────────────────────────────────────────────
  budgetPeriodStart DateTime? @db.Timestamptz(6)
  budgetPeriodEnd   DateTime? @db.Timestamptz(6)
  effectiveDate     DateTime  @default(now()) @db.Timestamptz(6)
  expirationDate    DateTime? @db.Timestamptz(6)

  // Budget approval workflow
  submittedForApprovalAt DateTime? @db.Timestamptz(6)
  approvedAt             DateTime? @db.Timestamptz(6)
  approvedByMemberId     String?   @db.Uuid
  approvalNotes          String?   @db.Text
  rejectedAt             DateTime? @db.Timestamptz(6)
  rejectionReason        String?   @db.Text

  // ─────────────────────────────────────────────────────────────
  // 💰 Financial Totals & Aggregations
  // ─────────────────────────────────────────────────────────────
  currencyCode String @default("USD") @db.Char(3)

  // Total budget amounts
  totalBudgetAmount   Decimal @default(0) @db.Decimal(15, 2)
  totalApprovedAmount Decimal @default(0) @db.Decimal(15, 2)
  totalPendingAmount  Decimal @default(0) @db.Decimal(15, 2)
  totalRejectedAmount Decimal @default(0) @db.Decimal(15, 2)

  // Category breakdowns
  laborBudgetAmount       Decimal @default(0) @db.Decimal(12, 2)
  materialBudgetAmount    Decimal @default(0) @db.Decimal(12, 2)
  equipmentBudgetAmount   Decimal @default(0) @db.Decimal(12, 2)
  subcontractBudgetAmount Decimal @default(0) @db.Decimal(12, 2)
  overheadBudgetAmount    Decimal @default(0) @db.Decimal(12, 2)
  contingencyAmount       Decimal @default(0) @db.Decimal(12, 2)

  // Actual cost tracking (denormalized for performance)
  totalActualCost      Decimal @default(0) @db.Decimal(15, 2)
  totalCommittedCost   Decimal @default(0) @db.Decimal(15, 2)
  totalAvailableAmount Decimal @default(0) @db.Decimal(15, 2)

  // Variance analysis
  totalVariance           Decimal @default(0) @db.Decimal(15, 2) // budget - (actual + committed)
  totalVariancePercentage Decimal @default(0) @db.Decimal(8, 4)

  // ─────────────────────────────────────────────────────────────
  // 📊 Budget Performance & Tracking
  // ─────────────────────────────────────────────────────────────
  percentComplete  Decimal @default(0) @db.Decimal(5, 2) // Budget utilization %
  percentApproved  Decimal @default(0) @db.Decimal(5, 2)
  percentCommitted Decimal @default(0) @db.Decimal(5, 2)
  percentSpent     Decimal @default(0) @db.Decimal(5, 2)

  // Line item counts
  totalLineItemCount    Int @default(0)
  approvedLineItemCount Int @default(0)
  pendingLineItemCount  Int @default(0)
  rejectedLineItemCount Int @default(0)

  // ─────────────────────────────────────────────────────────────
  // 🔄 Budget Revision Management
  // ─────────────────────────────────────────────────────────────
  revisionNumber    Int      @default(1)
  parentBudgetId    String?  @db.Uuid // Link to original budget
  isCurrentRevision Boolean  @default(true)
  revisionReason    String?  @db.Text
  revisionDate      DateTime @default(now()) @db.Timestamptz(6)

  // Change tracking
  changesFromPrevious Json?   @db.JsonB // Summary of changes
  majorChangeFlag     Boolean @default(false) // Requires special approval

  // ─────────────────────────────────────────────────────────────
  // 📋 Budget Configuration
  // ─────────────────────────────────────────────────────────────
  allowOverspend           Boolean @default(false)
  requireApprovalThreshold Decimal @default(1000) @db.Decimal(12, 2)
  warningThreshold         Decimal @default(0.90) @db.Decimal(5, 4) // 90%
  criticalThreshold        Decimal @default(0.95) @db.Decimal(5, 4) // 95%

  // Cost control flags
  isLocked             Boolean @default(false)
  allowsModifications  Boolean @default(true)
  requiresChangeOrders Boolean @default(false)

  // ─────────────────────────────────────────────────────────────
  // 🎯 Budget Scope & Categories
  // ─────────────────────────────────────────────────────────────
  budgetScope        String? @db.Text // What this budget covers
  includedActivities Json?   @db.JsonB // Activities included
  excludedActivities Json?   @db.JsonB // Activities excluded
  assumptions        String? @db.Text // Budget assumptions
  riskFactors        Json?   @db.JsonB // Risk considerations

  // ─────────────────────────────────────────────────────────────
  // 📈 Forecasting & Projections
  // ─────────────────────────────────────────────────────────────
  forecastAtCompletion Decimal?  @db.Decimal(15, 2) // EAC - Estimate at Completion
  estimateToComplete   Decimal?  @db.Decimal(15, 2) // ETC - Estimate to Complete
  budgetAtCompletion   Decimal?  @db.Decimal(15, 2) // BAC - Budget at Completion
  varianceAtCompletion Decimal?  @db.Decimal(15, 2) // VAC - Variance at Completion
  lastForecastUpdate   DateTime? @db.Timestamptz(6)

  // Performance indices
  costPerformanceIndex     Decimal? @db.Decimal(8, 4) // CPI = EV / AC
  schedulePerformanceIndex Decimal? @db.Decimal(8, 4) // SPI = EV / PV
  budgetEfficiencyRatio    Decimal? @db.Decimal(8, 4) // Efficiency metric

  // ─────────────────────────────────────────────────────────────
  // 🔗 External References
  // ─────────────────────────────────────────────────────────────
  sourceEstimateId  String? @db.Uuid // Original estimate
  contractId        String? @db.Uuid // Related contract
  changeOrderId     String? @db.Uuid // Related change order
  approvalRequestId String? @db.Uuid // Approval workflow

  // Cost codes and accounting
  defaultCostCenterId String? @db.Uuid
  accountingPeriodId  String? @db.Uuid
  jobCostingEnabled   Boolean @default(true)

  // ─────────────────────────────────────────────────────────────
  // 📝 Documentation & Notes
  // ─────────────────────────────────────────────────────────────
  budgetNotes    String? @db.Text
  internalNotes  String? @db.Text
  clientNotes    String? @db.Text
  reviewComments String? @db.Text

  // Document references
  attachmentCount    Int       @default(0)
  lastDocumentUpdate DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────
  tenant  Tenant  @relation("TenantToProjectBudget", fields: [tenantId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  // Budget approval
  approvedByMember Member? @relation("ProjectBudgetApprover", fields: [tenantId, approvedByMemberId], references: [tenantId, id], onDelete: SetNull)

  // External references
  sourceEstimate  Estimate?        @relation("EstimateToProjectBudget", fields: [tenantId, sourceEstimateId], references: [tenantId, id], onDelete: SetNull)
  contract        Contract?        @relation("ContractToProjectBudget", fields: [tenantId, contractId], references: [tenantId, id], onDelete: SetNull)
  changeOrder     ChangeOrder?     @relation("ChangeOrderToProjectBudget", fields: [tenantId, changeOrderId], references: [tenantId, id], onDelete: SetNull)
  approvalRequest ApprovalRequest? @relation("ProjectBudgetApprovalRequest", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: SetNull)

  // Budget hierarchy
  parentBudget ProjectBudget?  @relation("BudgetRevisions", fields: [tenantId, parentBudgetId], references: [tenantId, id], onDelete: SetNull)
  revisions    ProjectBudget[] @relation("BudgetRevisions")

  // Child relations
  lineItems ProjectBudgetLineItem[] @relation("BudgetToLineItems")

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes
  // ─────────────────────────────────────────────────────────────
  @@unique([tenantId, id])
  @@unique([tenantId, projectId, budgetCode]) // Unique budget codes per project
  @@unique([tenantId, projectId, revisionNumber]) // Unique revision numbers
  // Parent relationship
  @@index([tenantId, projectId]) // Most common lookup
  // Status & lifecycle
  @@index([tenantId, status])
  @@index([tenantId, budgetType])
  @@index([tenantId, deletedAt])
  // Current revision tracking
  @@index([tenantId, isCurrentRevision])
  @@index([tenantId, revisionNumber])
  @@index([tenantId, parentBudgetId])
  // Approval workflow
  @@index([tenantId, submittedForApprovalAt])
  @@index([tenantId, approvedAt])
  @@index([tenantId, approvedByMemberId])
  // Financial queries
  @@index([tenantId, totalBudgetAmount])
  @@index([tenantId, totalActualCost])
  @@index([tenantId, totalVariance])
  @@index([tenantId, percentComplete])
  // Performance tracking
  @@index([tenantId, percentSpent])
  @@index([tenantId, costPerformanceIndex])
  @@index([tenantId, forecastAtCompletion])
  // Timeline queries
  @@index([tenantId, effectiveDate])
  @@index([tenantId, budgetPeriodStart])
  @@index([tenantId, budgetPeriodEnd])
  // External references
  @@index([tenantId, sourceEstimateId])
  @@index([tenantId, contractId])
  @@index([tenantId, changeOrderId])
  @@index([tenantId, approvalRequestId])
  // Configuration flags
  @@index([tenantId, isLocked])
  @@index([tenantId, allowOverspend])
  @@index([tenantId, majorChangeFlag])
  // Temporal queries (BRIN for performance)
  @@index([createdAt], type: Brin)
  @@index([effectiveDate], type: Brin)
  @@index([lastForecastUpdate], type: Brin)
  // Governance
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  // JSON searches
  @@index([metadata], type: Gin)
  @@index([changesFromPrevious], type: Gin)
  @@index([riskFactors], type: Gin)
  @@map("project_budgets")
}

model ProjectBudgetLineItem {
  // ─────────────────────────────────────────────────────────────
  // 🆔 Primary Key & Identity (Pattern A - Child Entity)
  // ─────────────────────────────────────────────────────────────
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📊 Lifecycle & Concurrency
  // ─────────────────────────────────────────────────────────────
  status    ProjectBudgetItemStatus @default(DRAFT)
  version   Int                     @default(1)
  createdAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?               @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // 👤 Actor Attribution (Pattern A - IDs only for Child Entity)
  // ─────────────────────────────────────────────────────────────
  createdByActorId String? @db.Uuid
  updatedByActorId String? @db.Uuid
  deletedByActorId String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 🔍 Enterprise Governance
  // ─────────────────────────────────────────────────────────────
  auditCorrelationId String?                   @db.Uuid
  dataClassification ProjectDataClassification @default(CONFIDENTIAL)
  retentionPolicy    RetentionPolicy?
  recordSource       ProjectRecordSource?
  metadata           Json?                     @db.JsonB

  // ─────────────────────────────────────────────────────────────
  // 🔗 Parent Relationships (Required)
  // ─────────────────────────────────────────────────────────────
  projectId       String @db.Uuid
  projectBudgetId String @db.Uuid

  // Optional associations
  phaseId String? @db.Uuid
  taskId  String? @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // 📋 Line Item Identity & Classification
  // ─────────────────────────────────────────────────────────────
  lineItemNumber Int                       @db.Integer // Sequence within budget
  lineItemName   String                    @db.VarChar(500)
  lineItemCode   String?                   @db.VarChar(100)
  description    String?                   @db.Text
  lineItemType   ProjectBudgetLineItemType @default(COST_ITEM)
  costCategory   ProjectBudgetCostCategory @default(DIRECT_COST)
  displayOrder   Int                       @default(0)

  // ─────────────────────────────────────────────────────────────
