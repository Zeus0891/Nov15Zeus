  // ─────────────────────────────────────────────────────────────
  currencyCode String @default("USD") @db.Char(3)

  // Quantity and unit pricing
  quantity      Decimal @default(0) @db.Decimal(15, 4)
  unitOfMeasure String  @db.VarChar(50) // sq ft, hours, each, etc.
  unitCost      Decimal @default(0) @db.Decimal(12, 4)
  totalAmount   Decimal @default(0) @db.Decimal(15, 2) // quantity * unitCost

  // Budget allocation
  budgetedAmount Decimal @default(0) @db.Decimal(15, 2)
  approvedAmount Decimal @default(0) @db.Decimal(15, 2)
  pendingAmount  Decimal @default(0) @db.Decimal(15, 2)
  rejectedAmount Decimal @default(0) @db.Decimal(15, 2)

  // Cost breakdown
  laborCost       Decimal @default(0) @db.Decimal(12, 2)
  materialCost    Decimal @default(0) @db.Decimal(12, 2)
  equipmentCost   Decimal @default(0) @db.Decimal(12, 2)
  subcontractCost Decimal @default(0) @db.Decimal(12, 2)
  overheadCost    Decimal @default(0) @db.Decimal(12, 2)
  markupAmount    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)

  // Actual cost tracking
  actualCost      Decimal @default(0) @db.Decimal(15, 2)
  committedCost   Decimal @default(0) @db.Decimal(15, 2)
  remainingBudget Decimal @default(0) @db.Decimal(15, 2)

  // Variance analysis
  costVariance           Decimal @default(0) @db.Decimal(15, 2) // budget - actual
  costVariancePercentage Decimal @default(0) @db.Decimal(8, 4)
  quantityVariance       Decimal @default(0) @db.Decimal(15, 4)
  priceVariance          Decimal @default(0) @db.Decimal(15, 2)

  // ─────────────────────────────────────────────────────────────
  // 📊 Progress & Performance Tracking
  // ─────────────────────────────────────────────────────────────
  percentComplete   Decimal @default(0) @db.Decimal(5, 2) // Work completion %
  percentBudgetUsed Decimal @default(0) @db.Decimal(5, 2) // Budget utilization %
  percentCommitted  Decimal @default(0) @db.Decimal(5, 2) // Commitment level %

  // Earned value metrics
  plannedValue     Decimal @default(0) @db.Decimal(15, 2) // PV - Planned Value
  earnedValue      Decimal @default(0) @db.Decimal(15, 2) // EV - Earned Value
  actualCostToDate Decimal @default(0) @db.Decimal(15, 2) // AC - Actual Cost

  // Performance indices
  schedulePerformanceIndex Decimal @default(0) @db.Decimal(8, 4) // SPI = EV / PV
  costPerformanceIndex     Decimal @default(0) @db.Decimal(8, 4) // CPI = EV / AC

  // ─────────────────────────────────────────────────────────────
  // 📅 Timeline & Scheduling
  // ─────────────────────────────────────────────────────────────
  plannedStartDate DateTime? @db.Timestamptz(6)
  plannedEndDate   DateTime? @db.Timestamptz(6)
  actualStartDate  DateTime? @db.Timestamptz(6)
  actualEndDate    DateTime? @db.Timestamptz(6)

  // Budget period
  budgetPeriodStart DateTime? @db.Timestamptz(6)
  budgetPeriodEnd   DateTime? @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────────
  // ✅ Approval & Authorization
  // ─────────────────────────────────────────────────────────────
  requiresApproval       Boolean   @default(false)
  approvalThreshold      Decimal?  @db.Decimal(12, 2)
  submittedForApprovalAt DateTime? @db.Timestamptz(6)
  approvedAt             DateTime? @db.Timestamptz(6)
  approvedByMemberId     String?   @db.Uuid
  approvalNotes          String?   @db.Text
  rejectedAt             DateTime? @db.Timestamptz(6)
  rejectionReason        String?   @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🔄 Change Management
  // ─────────────────────────────────────────────────────────────
  originalAmount     Decimal   @default(0) @db.Decimal(15, 2)
  changeOrderAmount  Decimal   @default(0) @db.Decimal(15, 2)
  revisedAmount      Decimal   @default(0) @db.Decimal(15, 2)
  changeCount        Int       @default(0)
  lastChangeDate     DateTime? @db.Timestamptz(6)
  allowsModification Boolean   @default(true)
  isLocked           Boolean   @default(false)

  // ─────────────────────────────────────────────────────────────
  // 🏗️ Construction-Specific Fields
  // ─────────────────────────────────────────────────────────────
  workPackageCode String? @db.VarChar(100) // WBS code
  costCodeId      String? @db.Uuid // Job costing integration
  tradeSpecialty  String? @db.VarChar(100) // Construction trade
  skillLevel      String? @db.VarChar(50) // Required skill level
  laborHours      Decimal @default(0) @db.Decimal(10, 2)
  laborRate       Decimal @default(0) @db.Decimal(8, 2)
  equipmentHours  Decimal @default(0) @db.Decimal(10, 2)
  equipmentRate   Decimal @default(0) @db.Decimal(8, 2)

  // Material specifications
  materialSpecs      Json?    @db.JsonB // Material specifications
  supplierPreference String?  @db.VarChar(200)
  leadTime           Int? // Days for procurement
  minimumOrderQty    Decimal? @db.Decimal(15, 4)
  wasteAllowance     Decimal  @default(0) @db.Decimal(5, 4) // % waste factor

  // ─────────────────────────────────────────────────────────────
  // 📈 Forecasting & Estimates
  // ─────────────────────────────────────────────────────────────
  estimateAtCompletion Decimal?  @db.Decimal(15, 2) // EAC
  estimateToComplete   Decimal?  @db.Decimal(15, 2) // ETC
  varianceAtCompletion Decimal?  @db.Decimal(15, 2) // VAC
  forecastDate         DateTime? @db.Timestamptz(6)
  confidenceLevel      Decimal?  @db.Decimal(5, 2) // Forecast confidence %

  // Risk assessment
  riskLevel         ProjectRiskLevel @default(LOW)
  riskFactors       Json?            @db.JsonB // Risk considerations
  contingencyAmount Decimal          @default(0) @db.Decimal(12, 2)
  bufferAmount      Decimal          @default(0) @db.Decimal(12, 2)

  // ─────────────────────────────────────────────────────────────
  // 🔗 External References & Integration
  // ─────────────────────────────────────────────────────────────
  sourceEstimateLineItemId String? @db.Uuid // Original estimate line
  contractLineItemId       String? @db.Uuid // Contract reference
  changeOrderLineItemId    String? @db.Uuid // Change order reference
  purchaseOrderId          String? @db.Uuid // Related PO
  invoiceLineItemId        String? @db.Uuid // Billing reference
  inventoryItemId          String? @db.Uuid // Inventory integration

  // ─────────────────────────────────────────────────────────────
  // ⚙️ Business Flags
  // ─────────────────────────────────────────────────────────────
  isCriticalPath Boolean @default(false)
  isBillable     Boolean @default(true)
  isOptional     Boolean @default(false)
  isContingency  Boolean @default(false)
  isChangedItem  Boolean @default(false)
  isUserDefined  Boolean @default(false)

  // ─────────────────────────────────────────────────────────────
  // 📝 Documentation
  // ─────────────────────────────────────────────────────────────
  specifications String? @db.Text
  workScope      String? @db.Text
  deliverables   String? @db.Text
  assumptions    String? @db.Text
  exclusions     String? @db.Text
  notes          String? @db.Text
  internalNotes  String? @db.Text

  // ─────────────────────────────────────────────────────────────
  // 🔗 Relations
  // ─────────────────────────────────────────────────────────────
  tenant        Tenant        @relation("TenantToProjectBudgetLineItem", fields: [tenantId], references: [id], onDelete: Restrict)
  project       Project       @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  projectBudget ProjectBudget @relation("BudgetToLineItems", fields: [tenantId, projectBudgetId], references: [tenantId, id], onDelete: Cascade)

  // Optional associations
  phase ProjectPhase? @relation("ProjectPhaseTobudgetLineItems", fields: [tenantId, phaseId], references: [tenantId, id], onDelete: SetNull)
  task  ProjectTask?  @relation("ProjectTaskToBudgetLineItems", fields: [tenantId, taskId], references: [tenantId, id], onDelete: SetNull)

  // Approval
  approvedByMember Member? @relation("ProjectBudgetLineItemApprover", fields: [tenantId, approvedByMemberId], references: [tenantId, id], onDelete: SetNull)

  // External references
  sourceEstimateLineItem EstimateLineItem? @relation("EstimateLineItemToProjectBudgetLineItem", fields: [tenantId, sourceEstimateLineItemId], references: [tenantId, id], onDelete: SetNull)
  inventoryItem          InventoryItem?    @relation("InventoryItemToProjectBudgetLineItem", fields: [tenantId, inventoryItemId], references: [tenantId, id], onDelete: SetNull)

  // ─────────────────────────────────────────────────────────────
  // 📏 Constraints & Indexes
  // ─────────────────────────────────────────────────────────────
  @@unique([tenantId, id])
  @@unique([tenantId, projectBudgetId, lineItemNumber], map: "project_budget_line_items_number_key") // Unique line numbers per budget
  @@unique([tenantId, projectBudgetId, lineItemCode], map: "project_budget_line_items_code_key") // Unique codes per budget
  // Parent relationships
  @@index([tenantId, projectId]) // Project lookup
  @@index([tenantId, projectBudgetId]) // Budget lookup
  @@index([tenantId, phaseId]) // Phase association
  @@index([tenantId, taskId]) // Task association
  // Status & classification
  @@index([tenantId, status])
  @@index([tenantId, lineItemType])
  @@index([tenantId, costCategory])
  @@index([tenantId, deletedAt])
  // Financial queries
  @@index([tenantId, budgetedAmount])
  @@index([tenantId, actualCost])
  @@index([tenantId, totalAmount])
  @@index([tenantId, costVariance])
  // Performance tracking
  @@index([tenantId, percentComplete])
  @@index([tenantId, costPerformanceIndex])
  @@index([tenantId, schedulePerformanceIndex])
  // Timeline queries
  @@index([tenantId, plannedStartDate])
  @@index([tenantId, plannedEndDate])
  @@index([tenantId, actualStartDate])
  // Approval workflow
  @@index([tenantId, requiresApproval])
  @@index([tenantId, approvedAt])
  @@index([tenantId, approvedByMemberId])
  // Construction-specific
  @@index([tenantId, workPackageCode])
  @@index([tenantId, costCodeId])
  @@index([tenantId, tradeSpecialty])
  @@index([tenantId, laborHours])
  // External references
  @@index([tenantId, sourceEstimateLineItemId])
  @@index([tenantId, inventoryItemId])
  @@index([tenantId, purchaseOrderId])
  // Risk and forecasting
  @@index([tenantId, riskLevel])
  @@index([tenantId, estimateAtCompletion])
  @@index([tenantId, forecastDate])
  // Business flags
  @@index([tenantId, isCriticalPath])
  @@index([tenantId, isBillable])
  @@index([tenantId, isContingency])
  @@index([tenantId, isChangedItem])
  // Configuration
  @@index([tenantId, isLocked])
  @@index([tenantId, allowsModification])
  // Temporal queries (BRIN for performance)
  @@index([createdAt], type: Brin)
  @@index([plannedStartDate], type: Brin)
  @@index([forecastDate], type: Brin)
  // Governance
  @@index([tenantId, auditCorrelationId])
  @@index([tenantId, dataClassification])
  @@index([tenantId, recordSource])
  // JSON searches
  @@index([metadata], type: Gin)
  @@index([materialSpecs], type: Gin)
  @@index([riskFactors], type: Gin)
  @@map("project_budget_line_items")
}

