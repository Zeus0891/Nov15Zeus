  // Cost performance
  budgetedCost         Decimal  @default(0) @db.Decimal(12, 2)
  actualCost           Decimal  @default(0) @db.Decimal(12, 2)
  costVariance         Decimal  @default(0) @db.Decimal(12, 2)
  costPerformanceIndex Decimal? @db.Decimal(5, 4) // Cost efficiency

  // ─────────────────────────────────────────────────────────────
