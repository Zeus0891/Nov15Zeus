  contingencyDays   Int?             @default(0)
  mitigationActions String?          @db.Text

  // External dependencies
  externalDependencies Json?   @db.JsonB // Third-party dependencies
  vendorCoordination   String? @db.Text
  supplierRequirements Json?   @db.JsonB

